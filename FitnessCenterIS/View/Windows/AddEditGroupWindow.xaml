<Window x:Class="FitnessCenterIS.View.Windows.AddEditGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Добавление/редактирование группы" 
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="Foreground" Value="#090909"/>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 5"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" BorderBrush="#090909" BorderThickness="1" 
            materialDesign:ElevationAssist.Elevation="Dp3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="15" BorderThickness="0 0 0 1" BorderBrush="#e0e0e0">
                <Grid>
                    <TextBlock x:Name="TitleTextBlock" Text="Новая группа" FontSize="22" FontWeight="SemiBold" 
                               Foreground="#333333" VerticalAlignment="Center" Margin="20 0"/>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40 30">

                    <!-- Основная информация о группе -->
                    <TextBlock Text="Информация о группе" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0 0 0 25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0 0 15 0">
                            <TextBlock Text="Название группы*" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="NameTextBox" 
                                     materialDesign:HintAssist.Hint="Введите название группы"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="15 0 0 0">
                            <TextBlock Text="Услуга*" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox x:Name="ServiceComboBox"
                                      materialDesign:HintAssist.Hint="Выберите услугу"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      DisplayMemberPath="Name"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Описание группы" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="DescriptionTextBox" Height="100" TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             materialDesign:HintAssist.Hint="Введите описание группы"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0 0 0 25"/>

                    <Grid Margin="0 0 0 25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0 0 10 0">
                            <TextBlock Text="Максимум участников*" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="LimitCapacityTextBox"
                                     materialDesign:HintAssist.Hint="Введите лимит"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10 0">
                            <TextBlock Text="Скидка (%)" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="DiscountTextBox"
                                     materialDesign:HintAssist.Hint="Введите скидку (0-100)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10 0 0 0">
                            <TextBlock Text="Статус активности*" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox x:Name="StatusActivityComboBox"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                <ComboBoxItem Content="Активно"/>
                                <ComboBoxItem Content="Неактивно"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Валидационные сообщения -->
                    <TextBlock x:Name="ValidationTextBlock" Foreground="Red" 
                               Margin="0 10 0 0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки внизу -->
            <Border Grid.Row="2" Background="#f8f9fa" CornerRadius="15" BorderThickness="0 1 0 0" BorderBrush="#e0e0e0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20 10">
                        <Button Width="130" Height="40" Margin="0 0 15 0"
                                Background="#090909" Foreground="White" BorderBrush="Transparent"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Click="SaveButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0 0 8 0"/>
                                <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Width="120" Height="40" Margin="0"
                                Background="#7b7b7b" Foreground="White"
                                BorderThickness="0"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Click="CancelButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>