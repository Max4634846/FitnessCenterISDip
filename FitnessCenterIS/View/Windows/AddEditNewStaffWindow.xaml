<Window x:Class="FitnessCenterIS.View.Windows.AddEditNewStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Сотрудник"
        Height="680" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="Foreground" Value="#090909"/>
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 5"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" BorderBrush="#090909" BorderThickness="1"
            materialDesign:ElevationAssist.Elevation="Dp3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="15" BorderThickness="0 0 0 1" BorderBrush="#e0e0e0">
                <Grid>
                    <TextBlock x:Name="Title" Text="Новый сотрудник" FontSize="22" FontWeight="SemiBold"
                               Foreground="#333333" VerticalAlignment="Center" Margin="20 0"/>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <TabControl Grid.Row="1" x:Name="StaffInfoTabControl" Margin="0 10"
                        Style="{StaticResource MaterialDesignTabControl}"
                        materialDesign:ColorZoneAssist.Mode="Standard">
                <!-- Основная информация -->
                <TabItem Header="Основная информация">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая колонка: фото -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Фотография" Style="{StaticResource HeaderTextStyle}" Margin="25 0"/>
                                <Border Width="250" Height="250" Background="#f5f5f5"
                                        BorderBrush="#e0e0e0" BorderThickness="1" Margin="0 0 0 20">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" BorderBrush="#090909"
                                            BorderThickness="1"
                                            Width="250" Height="250" Padding="0" Click="BtnImage_Click">
                                        <Grid>
                                            <Image x:Name="StaffImage" Source="/Resource/NewPerson.jpg" Stretch="Fill"/>
                                            <materialDesign:PackIcon Kind="CameraPlus" Width="40" Height="40"
                                                                     Foreground="#90ffffff" Background="#80000000"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </Border>
                            </StackPanel>
                            <!-- Правая колонка: ФИО, контакты и пр. -->
                            <StackPanel Grid.Column="1" Margin="30 0 0 0">
                                <TextBlock Text="Личная информация" Style="{StaticResource SectionHeaderStyle}"/>
                                <Grid Margin="0 0 0 20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                                        <TextBlock Text="Фамилия" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="LastNameTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10 0">
                                        <TextBlock Text="Имя" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="FirstNameTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10 0 0 0">
                                        <TextBlock Text="Отчество" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="MiddleNameTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0 0 0 20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                                        <TextBlock Text="Телефон" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="PhoneNumberTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10 0">
                                        <TextBlock Text="Email" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="EmailTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10 0 0 0">
                                        <TextBlock Text="Дата рождения" Style="{StaticResource FormLabelStyle}"/>
                                        <DatePicker x:Name="DateOfBirthPicker" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0 0 0 20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                                        <TextBlock Text="Адрес" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="AddressTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10 0 0 0">
                                        <TextBlock Text="Пол" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox x:Name="GenderComboBox" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                            <ComboBoxItem Content="Муж"/>
                                            <ComboBoxItem Content="Жен"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Заметки" Style="{StaticResource HeaderTextStyle}" Margin="0 10 0 8"/>
                                <TextBox x:Name="Notes" Height="120" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Карточка сотрудника -->
                <TabItem Header="Карточка сотрудника">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="25">
                            <TextBlock Text="Информация о карте" HorizontalAlignment="Center" Style="{StaticResource SectionHeaderStyle}" Margin="0 0 0 15"/>
                            <TextBox x:Name="NumberCardTextBox" Width="300"
                                     materialDesign:HintAssist.Hint="Номер карты"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0 0 0 10"
                                     TextChanged="NumberCardTextBox_TextChanged"/>
                            <Button x:Name="GenerateCardButton" Width="300" Height="40"  
                                    Background="#090909" BorderBrush="Transparent" Content="Сгенерировать номер карты"
                                    Click="GenerateCardButton_Click" Margin="0 0 0 15"/>
                            <TextBlock Text="QR-Код" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center" Margin="0 0 0 8"/>
                            <Image x:Name="QRCodeImage" Width="180" Height="180" Margin="0 0 0 10"/>
                            <TextBlock Text="Должность" HorizontalAlignment="Center" Style="{StaticResource FormLabelStyle}" Margin="0 0 0 5"/>
                            <ComboBox x:Name="RoleComboBox" Width="250" Margin="0 0 0 15"
                                      DisplayMemberPath="Name" SelectedValuePath="RoleID"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            <TextBlock Text="Дата приема" HorizontalAlignment="Center" Style="{StaticResource FormLabelStyle}" Margin="0 0 0 5"/>
                            <DatePicker x:Name="HireDatePicker" Width="250" Margin="0 0 0 15"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                            <TextBlock x:Name="IdStaffLabel" Text="ID сотрудника" HorizontalAlignment="Center" Style="{StaticResource FormLabelStyle}" Margin="0 15 0 5"/>
                            <TextBox x:Name="IdStaff" Width="250" IsReadOnly="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Кнопки внизу -->
            <Border Grid.Row="2" Background="#f8f9fa" CornerRadius="15" BorderThickness="0 1 0 0" BorderBrush="#e0e0e0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20 10">
                        <Button x:Name="AddBtn" Width="130" Height="40"
                                Background="#090909" Foreground="White" BorderBrush="Transparent"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Click="AddStaffButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20" Margin="0 0 8 0"/>
                                <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="EditBtn" Width="180" Height="40"
                                Background="#090909" Foreground="White" BorderBrush="Transparent"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Click="AddStaffButton_Click" Visibility="Collapsed" Margin="0 0 15 0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0 0 8 0"/>
                                <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="120" Height="40" Margin="15 0 0 0"
                                Background="#090909"
                                BorderThickness="1" BorderBrush="Transparent"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Click="Exit_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
