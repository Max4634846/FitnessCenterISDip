<Window x:Class="FitnessCenterIS.View.Windows.AddEditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Пользователь"
        Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="Foreground" Value="#090909"/>
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 5"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" BorderBrush="#090909" BorderThickness="1"
            materialDesign:ElevationAssist.Elevation="Dp3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="15" BorderThickness="0 0 0 1" BorderBrush="#e0e0e0">
                <Grid>
                    <TextBlock x:Name="Title" Text="Новый пользователь" FontSize="22" FontWeight="SemiBold"
                               Foreground="#333333" VerticalAlignment="Center" Margin="20 0"/>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25">
                    <TextBlock Text="Информация о пользователе" Style="{StaticResource SectionHeaderStyle}" Margin="0 0 0 15"/>

                    <!-- Выбор сотрудника -->
                    <TextBlock Text="Сотрудник" Style="{StaticResource FormLabelStyle}" Margin="0 10 0 5"/>
                    <Grid>
                        <TextBox x:Name="StaffTextBox" Width="450" HorizontalAlignment="Left" Margin="0 0 0 15"
                                 materialDesign:HintAssist.Hint="Выберите сотрудника"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextChanged="StaffTextBox_TextChanged"/>
                        <Popup x:Name="StaffsPopup" PlacementTarget="{Binding ElementName=StaffTextBox}"
                               Placement="Bottom" IsOpen="False" StaysOpen="False" MaxHeight="150">
                            <Border BorderBrush="{StaticResource MaterialDesignDivider}" BorderThickness="1" Background="White">
                                <ListBox x:Name="StaffsListBoxInPopup" Width="450" SelectionChanged="StaffsListBoxInPopup_SelectionChanged"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Информация о выбранном сотруднике -->
                    <Grid Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0 0 10 0">
                            <TextBlock Text="Должность" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="RoleTextBox" IsReadOnly="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10 0 0 0">
                            <TextBlock Text="Телефон" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="PhoneTextBox" IsReadOnly="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Данные для входа -->
                    <TextBlock Text="Данные для входа" Style="{StaticResource SectionHeaderStyle}" Margin="0 15 0 15"/>
                    <Grid Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0 0 10 0">
                            <TextBlock Text="Логин" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="LoginTextBox" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10 0 0 0">
                            <TextBlock Text="Пароль" Style="{StaticResource FormLabelStyle}"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Дополнительные элементы при необходимости -->
                    <TextBlock x:Name="UserIdLabel" Text="ID пользователя" Style="{StaticResource FormLabelStyle}" 
                               Margin="0 15 0 5" Visibility="Collapsed"/>
                    <TextBox x:Name="UserId" Width="250" IsReadOnly="True" Visibility="Collapsed"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <!-- Скрытое поле для хранения ID выбранного сотрудника -->
                    <TextBox x:Name="SelectedStaffId" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки внизу -->
            <Border Grid.Row="2" Background="#f8f9fa" CornerRadius="15" BorderThickness="0 1 0 0" BorderBrush="#e0e0e0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20 10">
                        <Button x:Name="AddBtn" Width="130" Height="40"
                                Background="#090909" Foreground="White" BorderBrush="Transparent"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Click="AddUserButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20" Margin="0 0 8 0"/>
                                <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="EditBtn" Width="180" Height="40"
                                Background="#090909" Foreground="White" BorderBrush="Transparent"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Click="AddUserButton_Click" Visibility="Collapsed" Margin="0 0 15 0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0 0 8 0"/>
                                <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="120" Height="40" Margin="15 0 0 0"
                                Background="#090909"
                                BorderThickness="1" BorderBrush="Transparent"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Click="Exit_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>