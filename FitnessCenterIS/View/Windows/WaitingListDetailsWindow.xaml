<Window x:Class="FitnessCenterIS.View.Windows.WaitingListDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FitnessCenterIS.View.Windows"
        xmlns:model="clr-namespace:FitnessCenterIS.Model"
        Title="Детали записи в списке ожидания" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5">
    
    <Window.Resources>
        <model:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <model:BoolToVisibilityInvertConverter x:Key="BoolToVisibilityInvertConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Информация о записи в списке ожидания" 
                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

        <!-- Основная информация -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <Border Background="White" CornerRadius="8" Padding="15" 
                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовки -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Клиент:" FontWeight="SemiBold" Margin="0,0,10,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Услуга:" FontWeight="SemiBold" Margin="0,0,10,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата запроса:" FontWeight="SemiBold" Margin="0,0,10,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Запрошенное время:" FontWeight="SemiBold" Margin="0,0,10,10"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Статус:" FontWeight="SemiBold" Margin="0,0,10,10"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Занятие:" FontWeight="SemiBold" Margin="0,0,10,10"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Примечания:" FontWeight="SemiBold" Margin="0,0,10,10"/>

                        <!-- Значения -->
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ClientName}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServiceName}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EnrollmentDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:dd.MM.yyyy HH:mm} - {1:HH:mm}">
                                    <Binding Path="RequestedStartDateTime"/>
                                    <Binding Path="RequestedEndDateTime"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                                                Text="{Binding IsProcessed, Converter={StaticResource BoolToStatusConverter}}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ScheduleTitle}" Margin="0,0,0,10"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Notes}" 
                                 TextWrapping="Wrap" IsReadOnly="True" Height="80" 
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0" 
                                 Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- Дополнительная секция для управления записью -->
                <Border Background="White" CornerRadius="8" Padding="15" 
                        BorderBrush="#E0E0E0" BorderThickness="1" 
                        Visibility="{Binding IsProcessed, Converter={StaticResource BoolToVisibilityInvertConverter}}">
                    <StackPanel>
                        <TextBlock Text="Обработать запрос" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Вы можете обработать этот запрос, добавив клиента в расписание или отклонив запрос." 
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ApproveButton" Content="Добавить в расписание" 
                                    Background="#090909" Foreground="White" BorderThickness="0"
                                    Padding="10,5" Margin="0,0,10,0" Click="ApproveButton_Click"/>
                            <Button x:Name="DeclineButton" Content="Отклонить запрос" 
                                    Background="#090909" Foreground="White" BorderThickness="0"
                                    Padding="10,5" Click="DeclineButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки действий -->
        <Button Grid.Row="2" Content="Закрыть" Width="100" Height="35" 
                Background="#090909" Foreground="White" BorderThickness="0"
                HorizontalAlignment="Right" Margin="0,15,0,0" Click="CloseButton_Click"/>
    </Grid>
</Window>