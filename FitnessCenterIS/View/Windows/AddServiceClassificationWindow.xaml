<Window x:Class="FitnessCenterIS.View.Windows.AddServiceClassificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Классификации услуг" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="15" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3b3b3b" Offset="0"/>
                <GradientStop Color="#6b6b6b" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#f5f5f5" Offset="0"/>
                <GradientStop Color="#e5e5e5" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Управление классификациями услуг" FontSize="18" FontWeight="SemiBold" 
                           VerticalAlignment="Center" Margin="20,0,0,0"/>

                <Button Grid.Column="1" Width="30" Height="30" Margin="5,5,10,5"
                        Background="Transparent" BorderThickness="0"
                        Click="CloseButton_Click">
                    <Icon:PackIconMaterial Kind="Close" Height="12" Foreground="#090909"/>
                </Button>
            </Grid>

            <!-- Основное содержимое -->
            <Grid Grid.Row="1" Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель - список классификаций услуг -->
                <Border Grid.Column="0" CornerRadius="8" Background="White" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,10,0">
                    <DataGrid x:Name="ServiceClassificationsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" Margin="2"
                              SelectionChanged="ServiceClassificationsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Правая панель - редактирование/добавление классификации услуги -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Классификация услуги" FontWeight="Medium" Margin="0,0,0,10"/>

                    <TextBlock Text="Название" FontSize="12" Margin="5,0,0,5"/>
                    <Border CornerRadius="8" Background="#f0f0f0" Margin="0,0,0,15">
                        <TextBox x:Name="NameTextBox" Text="{Binding Name}" BorderThickness="0" 
                                 Background="Transparent" Padding="10,8"/>
                    </Border>

                    <TextBlock Text="Описание" FontSize="12" Margin="5,0,0,5"/>
                    <Border CornerRadius="8" Background="#f0f0f0" Margin="0,0,0,15">
                        <TextBox x:Name="DescriptionTextBox" Text="{Binding Description}" Height="80" 
                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" 
                                 Background="Transparent" Padding="10,8"/>
                    </Border>

                    <Button x:Name="SaveButton" Height="40" Content="Сохранить" Background="#090909"
                            BorderThickness="0"  Margin="5 0"
                            Click="SaveButton_Click"/>

                    <Button Content="Добавить" Margin="5 10" 
                        Height="40" Background="#090909"
                        BorderThickness="0"
                        Click="AddNewClassificationButton_Click"/>

                    <Button Content="Удалить" Margin="5 0" 
                            Height="40" Background="#090909" Foreground="White"
                            BorderThickness="0"
                            Click="DeleteButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Кнопки действий -->
            <Grid Grid.Row="2" Margin="20,10">
                <Button Content="Отмена" Margin="5 0" 
                        Height="40" Background="#090909" Foreground="White"
                        BorderThickness="0"  HorizontalAlignment="Right" Width="150"
                        Click="CloseButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
