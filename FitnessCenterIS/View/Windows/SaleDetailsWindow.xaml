<Window x:Class="FitnessCenterIS.View.Windows.SaleDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Детали продажи" Height="600" Width="800"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True">
    <Border Background="#f0f0f0" CornerRadius="15" BorderBrush="#090909" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- Заголовок -->
                <RowDefinition Height="*"/>
                <!-- Основной контент -->
                <RowDefinition Height="60"/>
                <!-- Кнопки внизу -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#f0f0f0" CornerRadius="15,15,0,0">
                <Grid>
                    <TextBlock x:Name="TitleTextBlock" Text="Детали продажи №123" 
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             FontSize="22" FontWeight="SemiBold" Foreground="#333" Margin="20 0 0 0"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 20 0"
                          Background="Transparent" BorderThickness="0" Padding="5"
                          Click="CloseButton_Click">
                        <Icon:PackIconMaterial Kind="Close" Width="20" Height="20" Foreground="#333"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <!-- Секция Основная информация -->
                    <TextBlock Text="Основная информация" FontSize="18" FontWeight="Bold" Margin="0 0 0 15"/>
                    <Grid Margin="0 0 0 25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0 0 15 15">
                            <TextBlock Text="Дата и время продажи" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="SaleDateTimeTextBlock" Text="01.05.2025 15:30" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="2" Margin="0 0 15 15">
                            <TextBlock Text="Статус продажи" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="StatusTextBlock" Text="Активна" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="3" Margin="0 0 15 0">
                            <TextBlock Text="Администратор" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="AdministratorTextBlock" Text="Иванов Иван" Foreground="#555"/>
                        </StackPanel>

                        <!-- Правая колонка -->
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="15 0 0 15">
                            <TextBlock Text="Сумма продажи" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="PriceTextBlock" Text="5000.00 ₽" FontWeight="Bold" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="15 0 0 15">
                            <TextBlock Text="Скидка" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="DiscountTextBlock" Text="0.00 ₽" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="2" Margin="15 0 0 15">
                            <TextBlock Text="НДС" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="VatTextBlock" Text="НДС 20%" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="3" Margin="15 0 0 0">
                            <TextBlock Text="Способ оплаты" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="PaymentMethodTextBlock" Text="Наличные" Foreground="#555"/>
                        </StackPanel>
                    </Grid>

                    <!-- Секция Информация о клиенте -->
                    <TextBlock Text="Информация о клиенте" FontSize="18" FontWeight="Bold" Margin="0 0 0 15"/>
                    <Grid Margin="0 0 0 25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0 0 15 15">
                            <TextBlock Text="ФИО клиента" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="ClientNameTextBlock" Text="Петров Петр Петрович" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0 0 15 0">
                            <TextBlock Text="Телефон" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="PhoneTextBlock" Text="+7 (999) 123-45-67" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="15 0 0 15">
                            <TextBlock Text="Номер карты" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="CardNumberTextBlock" Text="FC123456" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="15 0 0 0">
                            <TextBlock Text="Бонусные баллы начислено" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="BonusPointsTextBlock" Text="250" Foreground="#555"/>
                        </StackPanel>
                    </Grid>

                    <!-- Секция Информация о продукте/услуге -->
                    <TextBlock Text="Информация о продукте/услуге" FontSize="18" FontWeight="Bold" Margin="0 0 0 15"/>
                    <Grid Margin="0 0 0 25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0 0 15 15">
                            <TextBlock Text="Тип" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="ProductTypeTextBlock" Text="Абонемент" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0 0 15 15">
                            <TextBlock Text="Название" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="ProductNameTextBlock" Text="Стандартный абонемент" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="2" Margin="0 0 15 0">
                            <TextBlock Text="Тренер" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="TrainerTextBlock" Text="Сидоров Алексей" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="15 0 0 15">
                            <TextBlock Text="Срок действия" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="ValidityTextBlock" Text="01.05.2025 - 01.06.2025" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="15 0 0 15">
                            <TextBlock Text="Осталось занятий" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="RemainingVisitsTextBlock" Text="8" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="2" Margin="15 0 0 0">
                            <TextBlock Text="Группа" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBlock x:Name="GroupTextBlock" Text="Группа 121" Foreground="#555"/>
                        </StackPanel>
                    </Grid>

                    <!-- Секция История платежей -->
                    <TextBlock Text="История платежей" FontSize="18" FontWeight="Bold" Margin="0 0 0 15"/>
                    <DataGrid x:Name="PaymentsDataGrid" 
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            Height="120"
                            Margin="0 0 0 25"
                            BorderThickness="1"
                            BorderBrush="#E0E0E0"
                            GridLinesVisibility="Horizontal"
                            AlternatingRowBackground="#F9F9F9"
                            RowBackground="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding PaymentID}" Width="60"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding DateTime, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" Width="100"/>
                            <DataGridTextColumn Header="Способ оплаты" Binding="{Binding PaymentMethod}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Секция Примечания -->
                    <TextBlock Text="Примечания" FontSize="18" FontWeight="Bold" Margin="0 0 0 15"/>
                    <TextBox x:Name="NotesTextBox" Height="80" IsReadOnly="True" 
                           TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                           BorderThickness="1" BorderBrush="#E0E0E0" Padding="10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки внизу -->
            <Border Grid.Row="2" Background="#f0f0f0" CornerRadius="0,0,15,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20 10">
                    <Button Content="Изменить статус" Click="ChangeStatus_Click" 
                          Background="#007bff" Foreground="White" BorderThickness="0"
                          Height="40" Padding="15 0" Margin="0 0 10 0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Печать чека" Click="PrintReceipt_Click" 
                          Background="#28a745" Foreground="White" BorderThickness="0"
                          Height="40" Padding="15 0" Margin="0 0 10 0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Закрыть" Click="CloseButton_Click" 
                          Background="#6c757d" Foreground="White" BorderThickness="0"
                          Height="40" Padding="15 0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>