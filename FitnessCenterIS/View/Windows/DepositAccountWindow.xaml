<Window x:Class="FitnessCenterIS.View.Windows.DepositAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Управление депозитным счетом" 
        Height="850" Width="600"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True">

    <Border Background="#f0f0f0" CornerRadius="15" BorderBrush="#090909" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- Заголовок -->
                <RowDefinition Height="*"/>
                <!-- Основной контент -->
                <RowDefinition Height="60"/>
                <!-- Кнопки внизу -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#090909" CornerRadius="15,15,0,0">
                <Grid>
                    <TextBlock x:Name="OperationTypeTextBlock" Text="Управление депозитным счетом" 
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontSize="22" FontWeight="SemiBold" Foreground="White" Margin="20,0,0,0"/>
                    <Button Click="CancelButton_Click" Width="30" Height="30" 
                            HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Background="Transparent" BorderThickness="0" Margin="0,0,20,0">
                        <Icon:PackIconMaterial Kind="Close" Width="20" Height="20" Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <Grid Grid.Row="1" Margin="20">
                <StackPanel>
                    <!-- Информация о клиенте -->
                    <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Клиент" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock x:Name="ClientNameTextBlock" FontSize="18" FontWeight="Bold"/>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Депозитный счет -->
                                <Border Grid.Column="0" Background="#f0f7ff" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Депозитный счет" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AvailableDepositTextBlock" FontSize="20" FontWeight="Bold" Foreground="#2980b9"/>
                                    </StackPanel>
                                </Border>

                                <!-- Бонусный счет -->
                                <Border Grid.Column="1" Background="#e8f7f2" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Бонусные баллы" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AvailableBonusTextBlock" FontSize="20" FontWeight="Bold" Foreground="#27ae60"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Сумма и способ оплаты -->
                    <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Детали платежа" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Сумма -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Сумма:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="AmountTextBox" Padding="10,5" Margin="0,5" 
                                         TextChanged="AmountTextBox_TextChanged"/>

                                <!-- Итоговая сумма -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Итого:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,10,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TotalAmountTextBlock" FontSize="16" FontWeight="Bold" 
                                           Margin="0,10,0,5" VerticalAlignment="Center"/>

                                <!-- Способ оплаты -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Способ оплаты:" VerticalAlignment="Center" Margin="0,5,10,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="PaymentMethodComboBox" 
                                          DisplayMemberPath="Name" SelectedValuePath="PaymentMethodID"
                                          Padding="10,5" Margin="0,5"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Разделение платежа (для оплаты) -->
                    <Border x:Name="SplitPaymentPanel" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Распределение платежа" FontSize="16" FontWeight="SemiBold"/>
                                <Button x:Name="ResetButton" Content="Сбросить" HorizontalAlignment="Right" 
                                        Padding="10,3" Background="Transparent" Foreground="#e74c3c" 
                                        BorderThickness="1" BorderBrush="#e74c3c" Click="ResetButton_Click"/>
                            </Grid>

                            <!-- Оплата с депозита -->
                            <TextBlock Text="Списать с депозита:" Margin="0,15,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" x:Name="DepositAmountSlider" Minimum="0" Maximum="1000" 
                                        TickFrequency="100" IsSnapToTickEnabled="False" 
                                        ValueChanged="DepositAmountSlider_ValueChanged"/>
                                <TextBlock Grid.Column="1" x:Name="DepositAmountTextBlock" Text="0.00 ₽" 
                                           Margin="10,0,0,0" MinWidth="80" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Использование бонусов (для оплаты) -->
                    <Border x:Name="BonusPaymentPanel" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Использовать бонусные баллы:" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" x:Name="BonusAmountSlider" Minimum="0" Maximum="1000" 
                                        TickFrequency="100" IsSnapToTickEnabled="False" 
                                        ValueChanged="BonusAmountSlider_ValueChanged"/>
                                <TextBlock Grid.Column="1" x:Name="BonusAmountTextBlock" Text="0.00" 
                                           Margin="10,0,0,0" MinWidth="80" TextAlignment="Right"/>
                            </Grid>

                            <!-- Оставшаяся сумма к оплате картой -->
                            <Grid Margin="0,15,0,0">
                                <TextBlock Text="К оплате картой:" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CardAmountTextBlock" Text="0.00 ₽" 
                                           HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>

                            <!-- Сообщение об ошибке -->
                            <TextBlock x:Name="ErrorTextBlock" Foreground="#e74c3c" TextWrapping="Wrap" 
                                       Visibility="Collapsed" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Кнопки внизу -->
            <Border Grid.Row="2" Background="#f0f0f0" CornerRadius="0,0,15,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10">
                    <Button x:Name="ConfirmButton" Click="ConfirmButton_Click" 
                        Background="#090909" BorderBrush="Transparent" Foreground="White"
                        Height="40" Margin="0,0,10,0" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="CheckCircleOutline" Margin="0,0,8,0"/>
                            <TextBlock Text="Подтвердить"/>
                        </StackPanel>
                    </Button>
                    <Button Click="CancelButton_Click" Background="#f5f5f5" BorderThickness="1" 
                            BorderBrush="#dedede" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Отмена"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>