<Window x:Class="FitnessCenterIS.View.Windows.EditScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Редактирование занятия" Height="650" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>


    <Border CornerRadius="15" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3b3b3b" Offset="0"/>
                <GradientStop Color="#6b6b6b" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#f5f5f5" Offset="0"/>
                <GradientStop Color="#e5e5e5" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="WindowTitle" Text="Редактирование занятия" FontSize="22" FontWeight="SemiBold" 
                           VerticalAlignment="Center" Foreground="#333"/>

            </Grid>

            <!-- Основное содержимое -->
            <ScrollViewer Grid.Row="1" Margin="0,15,0,0" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <TextBlock Text="Название занятия" FontSize="14" Margin="0,0,0,5"/>
                    <Border CornerRadius="8"  BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15">
                        <TextBox x:Name="TitleTextBox" 
                                 Text="{Binding Note}"  Padding="10,8"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 />
                    </Border>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Дата" FontSize="14" Margin="0,0,0,5"/>
                            <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1">
                                <DatePicker x:Name="DatePicker" SelectedDate="{Binding StartDateTime}" Padding="10,8" 
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Услуга" FontSize="14" Margin="0,0,0,5"/>
                            <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1">
                                <ComboBox x:Name="ServiceComboBox" SelectedValue="{Binding SeasonticketServiceID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Padding="10,8" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          DisplayMemberPath="Name" SelectedValuePath="ServiceID"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Время начала" FontSize="14" Margin="0,0,0,5"/>
                            <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1">
                                <TextBox x:Name="StartTimeTextBox" Padding="10,8"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Время окончания" FontSize="14" Margin="0,0,0,5"/>
                            <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1">
                                <TextBox x:Name="EndTimeTextBox" Padding="10,8" 
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Тренер" FontSize="14" Margin="0,0,0,5"/>
                    <Border CornerRadius="8"  BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15">
                        <ComboBox x:Name="TrainerComboBox" SelectedValue="{Binding TrainerID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                  Padding="10,8" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  DisplayMemberPath="FullName" SelectedValuePath="StaffID"/>
                    </Border>

                    <TextBlock Text="Помещение" FontSize="14" Margin="0,0,0,5"/>
                    <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15">
                        <ComboBox x:Name="RoomComboBox" SelectedValue="{Binding RoomID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                  Padding="10,8" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  DisplayMemberPath="Name" SelectedValuePath="RoomID"/>
                    </Border>

                    <TextBlock Text="Клиент" FontSize="14" Margin="0,0,0,5"/>
                    <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15">
                        <ComboBox x:Name="ClientComboBox" SelectedValue="{Binding ClientID}" 
                                  Padding="10,8" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  DisplayMemberPath="FullName" SelectedValuePath="ClientID"/>
                    </Border>   

                    <TextBlock Text="Группа" FontSize="14" Margin="0,0,0,5"/>
                    <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15">
                        <ComboBox x:Name="GroupComboBox" SelectedValue="{Binding GroupID}" 
                                  Padding="10,8" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  DisplayMemberPath="Name" SelectedValuePath="GroupID"/>
                    </Border>

                    <TextBlock Text="Статус" FontSize="14" Margin="0,0,0,5"/>
                    <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15">
                        <ComboBox x:Name="StatusComboBox" SelectedValue="{Binding ScheduleStatus}" 
                                  Padding="10,8" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="Активно"/>
                            <ComboBoxItem Content="Отменено"/>
                            <ComboBoxItem Content="Завершено"/>
                        </ComboBox>
                    </Border>


                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" >

                <Button Content="Сохранить" Width="120" Height="40"  Margin="10,0,0,0"
                        Background="#090909" Foreground="White" BorderThickness="0"
                        Click="SaveButton_Click"/>

                <Button x:Name="DeleteButton" Content="Удалить" Margin="10,0,0,0"
                        Width="120" Height="40" HorizontalAlignment="Left"
                        Background="#090909" Foreground="White" BorderThickness="0"
                        Click="DeleteButton_Click"  Visibility="{Binding Path=_isEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Button Content="Отмена" Width="120" Height="40" Margin="10,0,0,0"
                        Background="#090909" Foreground="White" BorderThickness="0"
                        Click="CancelButton_Click"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>
