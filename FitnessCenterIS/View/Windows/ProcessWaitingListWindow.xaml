<Window x:Class="FitnessCenterIS.View.Windows.ProcessWaitingListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Обработка записи из списка ожидания" Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="15" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3b3b3b" Offset="0"/>
                <GradientStop Color="#6b6b6b" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#f5f5f5" Offset="0"/>
                <GradientStop Color="#e5e5e5" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="Обработка записи из списка ожидания" FontSize="22" FontWeight="SemiBold" 
                       VerticalAlignment="Center" Foreground="#333"/>

            <!-- Основное содержимое -->
            <StackPanel Grid.Row="1" Margin="0,15,0,0">
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Клиент:" FontWeight="SemiBold" Grid.Row="0" Grid.Column="0"/>
                    <TextBlock x:Name="ClientNameTextBlock" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Услуга:" FontWeight="SemiBold" Grid.Row="1" Grid.Column="0" Margin="0,10,0,0"/>
                    <TextBlock x:Name="ServiceNameTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"/>

                    <TextBlock Text="Дата записи:" FontWeight="SemiBold" Grid.Row="2" Grid.Column="0" Margin="0,10,0,0"/>
                    <TextBlock x:Name="EnrollmentDateTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"/>
                </Grid>

                <TextBlock Text="Доступные занятия:" FontSize="14" Margin="0,0,0,5"/>
                <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15">
                    <ComboBox x:Name="SchedulesComboBox" Padding="10,8" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding StartDateTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Title}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>

                <TextBlock Text="Примечания:" FontSize="14" Margin="0,0,0,5"/>
                <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15">
                    <TextBox x:Name="NotesTextBox" Padding="10,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="100"/>
                </Border>
            </StackPanel>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Назначить" Width="120" Height="40" Margin="10,0,0,0"
                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                        Click="ProcessButton_Click"/>

                <Button Content="Отменить запись" Width="120" Height="40" Margin="10,0,0,0"
                        Background="#F44336" Foreground="White" BorderThickness="0"
                        Click="CancelButton_Click"/>

                <Button Content="Закрыть" Width="120" Height="40" Margin="10,0,0,0"
                        Background="#090909" Foreground="White" BorderThickness="0"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
