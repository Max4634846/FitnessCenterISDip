<Window x:Class="FitnessCenterIS.View.Windows.NewSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Новая Продажа" Height="680" Width="900"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True">
    <Border Background="#f0f0f0" CornerRadius="15" BorderBrush="#090909" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- Заголовок -->
                <RowDefinition Height="*"/>
                <!-- Основной контент -->
                <RowDefinition Height="60"/>
                <!-- Кнопки внизу -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#f0f0f0" CornerRadius="15"> 
                <Grid>
                    <TextBlock Text="Новая продажа" HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="22" FontWeight="SemiBold" Foreground="#333" Margin="20 0 0 0"/>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <!-- Левая панель -->
                    <ColumnDefinition Width="*"/>
                    <!-- Правая панель -->
                </Grid.ColumnDefinitions>

                <!-- Левая панель - Информация о клиенте и абонементах -->
                <Border Grid.Column="0" Background="#f9f9f9" BorderThickness="0 0 1 0" BorderBrush="#e0e0e0" Margin="10 0 0 0">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Поиск клиента -->
                            <RowDefinition Height="Auto"/>
                            <!-- Информация о клиенте -->
                            <RowDefinition Height="Auto"/>
                            <!-- Тип продажи -->
                            <RowDefinition Height="Auto"/>
                            <!-- Выбор абонемента -->
                            <RowDefinition Height="*"/>
                            <!-- Список выбранных абонементов -->
                            <RowDefinition Height="Auto"/>
                            <!-- Кнопки управления списком -->
                        </Grid.RowDefinitions>

                        <!-- Поиск клиента -->
                        <StackPanel Grid.Row="0" Margin="0 0 0 15">
                            <TextBlock Text="Поиск клиента" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>
                            <Grid>
                                <TextBox x:Name="ClientTextBox" Padding="8 6" BorderThickness="1" 
                                     BorderBrush="#ccc" TextChanged="ClientTextBox_TextChanged"/>
                                <Popup x:Name="ClientsPopup" PlacementTarget="{Binding ElementName=ClientTextBox}"
                                   Placement="Bottom" IsOpen="False" StaysOpen="False" MaxHeight="200" Width="{Binding ElementName=ClientTextBox, Path=ActualWidth}">
                                    <Border BorderBrush="#ccc" BorderThickness="1" Background="White">
                                        <ListBox x:Name="ClientsListBoxInPopup" SelectionChanged="ClientsListBoxInPopup_SelectionChanged"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <!-- Информация о клиенте -->
                        <Border Grid.Row="1" Background="White" BorderThickness="1" BorderBrush="#e0e0e0" 
                            CornerRadius="4" Padding="10" Margin="0 0 0 15">
                            <StackPanel>
                                <TextBlock Text="Информация о клиенте" FontWeight="SemiBold" Margin="0 0 0 5"/>
                                <TextBlock x:Name="ClientInfoTextBlock" TextWrapping="Wrap" Foreground="#555"/>
                            </StackPanel>
                        </Border>

                        <!-- Тип продажи -->
                        <StackPanel Grid.Row="2" Margin="0 0 0 15">
                            <TextBlock Text="Тип продажи" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                                <RadioButton x:Name="MembershipRadioButton" Content="Абонемент" Margin="0 0 15 0"
                                             IsChecked="True" Checked="SaleTypeRadioButton_Checked"
                                             Background="#090909"/>
                                <RadioButton x:Name="ServiceRadioButton" Content="Услуга" 
                                             Checked="SaleTypeRadioButton_Checked"
                                             Background="#090909"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Выбор абонемента/услуги -->
                        <StackPanel Grid.Row="3" Margin="0 0 0 15" x:Name="MembershipSelectionPanel">
                            <TextBlock Text="Выбор абонемента" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="MembershipComboBox" Padding="8 6" 
                                      DisplayMemberPath="Name" SelectedValuePath="SeasonticketID"
                                      SelectionChanged="MembershipComboBox_SelectionChanged"/>
                                <Button Grid.Column="1" Content="Добавить" Margin="5 0 0 0" Padding="10 6"
                                    Background="#090909" Foreground="White" BorderThickness="0"
                                    Click="AddMembership_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0 0 0 15" x:Name="ServiceSelectionPanel" Visibility="Collapsed">
                            <TextBlock x:Name="ServiceLabel" Text="Выбор услуги" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>
                            <ComboBox x:Name="ServiceComboBox" Padding="8 6" 
                                  DisplayMemberPath="Name" SelectedValuePath="ServiceID"
                                  SelectionChanged="ServiceComboBox_SelectionChanged"/>
                        </StackPanel>

                        <!-- Список выбранных абонементов -->
                        <Grid Grid.Row="4" x:Name="SelectedMembershipsPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="MembershipLabel" Grid.Row="0" Text="Выбранные абонементы" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>
                            <ListView Grid.Row="1" x:Name="SelectedMembershipsListView" BorderThickness="1" BorderBrush="#e0e0e0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                        <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding Price}" Width="70"/>
                                        <GridViewColumn Header="Занятия" DisplayMemberBinding="{Binding Visits}" Width="70"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>

                        <!-- Кнопки управления списком -->
                        <Button Grid.Row="5" Content="Удалить выбранный" Margin="0 10 0 0" Padding="10 6"
                            Background="#f44336" Foreground="White" BorderThickness="0"
                            Click="RemoveMembership_Click" x:Name="RemoveMembershipButton"/>
                    </Grid>
                </Border>

                <!-- Правая панель - Детали продажи -->
                <Grid Grid.Column="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Администратор и тренер -->
                        <RowDefinition Height="Auto"/>
                        <!-- Детали продажи -->
                        <RowDefinition Height="Auto"/>
                        <!-- Бонусные баллы -->
                        <RowDefinition Height="Auto"/>
                        <!-- Итоговая стоимость -->
                        <RowDefinition Height="*"/>
                        <!-- Дополнительная информация -->
                    </Grid.RowDefinitions>

                    <!-- Администратор и тренер -->
                    <Grid Grid.Row="0" Margin="0 0 0 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0 0 10 0">
                            <TextBlock Text="Администратор" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <ComboBox x:Name="AdministratorComboBox" Padding="8 6" 
                                  DisplayMemberPath="Name" SelectedValuePath="StaffID"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10 0 0 0">
                            <TextBlock x:Name="TrainerLabel" Text="Тренер" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <ComboBox x:Name="TrainerComboBox" Padding="8 6" 
                                  DisplayMemberPath="Name" SelectedValuePath="TrainerID"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0 15 10 0">
                            <TextBlock Text="Дата продажи" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <DatePicker x:Name="SaleDatePicker" Padding="8 6"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10 15 0 0">
                            <TextBlock Text="Способ оплаты" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <ComboBox x:Name="PaymentMethodComboBox" Padding="8 6" 
                                  DisplayMemberPath="Name" SelectedValuePath="PaymentMethodID"/>
                        </StackPanel>
                    </Grid>

                    <!-- Детали продажи -->
                    <Grid Grid.Row="1" Margin="0 0 0 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0 0 10 0">
                            <TextBlock Text="Количество занятий" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 5"
                                   x:Name="RemainingVisitsLabel"/>
                            <ComboBox x:Name="RemainingVisitsComboBox" Padding="8 6" 
                                  SelectionChanged="RemainingVisitsComboBox_SelectionChanged">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="12"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10 0 0 0">
                            <TextBlock Text="Скидка" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <TextBox x:Name="DiscountTextBox" Padding="8 6" Text="0" 
                                 TextChanged="DiscountTextBox_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0 15 10 0">
                            <TextBlock Text="Статус продажи" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <ComboBox x:Name="StatusSaleComboBox" Padding="8 6"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10 15 0 0">
                            <TextBlock Text="НДС" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <ComboBox x:Name="VatRateComboBox" Padding="8 6" 
                                  DisplayMemberPath="Name" SelectedValuePath="VatRateID"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0 15 10 0" x:Name="StartDatePanel">
                            <TextBlock Text="Дата начала" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <DatePicker x:Name="StartDateTimePicker" Padding="8 6"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10 15 0 0" x:Name="EndDatePanel">
                            <TextBlock Text="Дата окончания" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <DatePicker x:Name="EndDateTimePicker" Padding="8 6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Бонусные баллы -->
                    <Border Grid.Row="2" Background="#f0f7ff" BorderThickness="1" BorderBrush="#d0e1f9" 
                        CornerRadius="4" Padding="15" Margin="0 0 0 20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Icon:PackIconMaterialDesign Kind="Gif" Width="24" Height="24" Foreground="#4285f4" 
                                                     VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Бонусные баллы за покупку" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BonusPointsTextBlock" FontSize="18" Foreground="#4285f4"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Итоговая стоимость -->
                    <Border Grid.Row="3" Background="#f5f5f5" BorderThickness="1" BorderBrush="#e0e0e0" 
                        CornerRadius="4" Padding="15" Margin="0 0 0 20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Цена продажи" FontWeight="SemiBold"/>
                                <TextBox x:Name="PriceSoldTextBox" Margin="0 5 0 0" Padding="8 6" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="TotalCostTextBlock" 
                                   FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="15 0 0 0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Кнопки внизу -->
            <Border Grid.Row="2" Background="#f0f0f0" CornerRadius="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20 10">
                    <Button x:Name="SaveSaleButton" Click="SaveSaleButton_Click" 
                        Background="#090909" BorderBrush="Transparent"
                        Height="40" Margin="0 0 10 0">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterialDesign Kind="PointOfSaleSharp" Margin="0 0 8 0"/>
                            <TextBlock Text="Провести продажу"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Exit_Click" Background="#0f0f0f" BorderThickness="1" BorderBrush="Transparent" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Отмена"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
