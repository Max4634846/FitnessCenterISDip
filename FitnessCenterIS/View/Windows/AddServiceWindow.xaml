<Window x:Class="FitnessCenterIS.View.Windows.AddServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitnessCenterIS.View.Windows"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Добавление услуги" Height="800" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown">
    
    <Border CornerRadius="15" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3b3b3b" Offset="0"/>
                <GradientStop Color="#6b6b6b" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#f5f5f5" Offset="0"/>
                <GradientStop Color="#e5e5e5" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок и кнопки управления окном -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="WindowTitle" Text="Новая услуга" FontSize="18" FontWeight="SemiBold" 
                           VerticalAlignment="Center" Margin="20,0,0,0"/>

            </Grid>
            
            <!-- Основное содержимое -->
            <ScrollViewer Grid.Row="1" Margin="20,10" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <TextBlock Text="Название" FontSize="12" Margin="5,0,0,5"/>
                    <Border CornerRadius="8" Background="#f0f0f0" Margin="0,0,0,15">
                        <TextBox x:Name="NameTextBox" Text="{Binding Name}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Background="Transparent" Padding="10,8"/>
                    </Border>
                    
                    <TextBlock Text="Цена" FontSize="12" Margin="5,0,0,5"/>
                    <Border CornerRadius="8" Background="#f0f0f0" Margin="0,0,0,15">
                        <TextBox x:Name="PriceTextBox" Text="{Binding Price}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Background="Transparent" Padding="10,8"/>
                    </Border>
                    
                    <!-- Тип услуги с кнопкой добавления -->
                    <TextBlock Text="Тип услуги" FontSize="12" Margin="5,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border CornerRadius="8" Background="#f0f0f0">
                            <ComboBox x:Name="ServiceTypeComboBox" SelectedValue="{Binding SeviceTypeID}" 
                                      SelectedValuePath="ServiceTypeID" DisplayMemberPath="Name"
                                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Background="Transparent" Padding="5,8"/>
                            
                        </Border>
                        <Button Content="+" Grid.Column="1" Margin="5 0" 
                                Height="35" Background="#090909" Foreground="White"
                                BorderThickness="0" 
                                Click="AddServiceType_Click"/>

                    </Grid>
                    
                    <!-- Классификация услуги с кнопкой добавления -->
                    <TextBlock Text="Классификация услуги" FontSize="12" Margin="5,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border CornerRadius="8" Background="#f0f0f0">
                            <ComboBox x:Name="ServiceClassificationComboBox" SelectedValue="{Binding ServiceClassificationID}" 
                                      SelectedValuePath="ServiceClassificationID" DisplayMemberPath="Name"
                                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Background="Transparent" Padding="5,8"/>
                        </Border>
                        <Button Content="+" Grid.Column="1" Margin="5 0" 
                                Height="35" Background="#090909" Foreground="White"
                                BorderThickness="0" 
                                Click="AddServiceClassification_Click"/>
                       
                    </Grid>

                    <TextBlock Text="Назначенный тренер" FontSize="12" Margin="5,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Border CornerRadius="8" Background="#f0f0f0">
                            <ComboBox x:Name="TrainerComboBox" 
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Background="Transparent" Padding="5,8"
                                      DisplayMemberPath="Name" 
                                      SelectedValuePath="TrainerID"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Минимальный возраст" FontSize="12" Margin="5,0,0,5"/>
                            <Border CornerRadius="8" Background="#f0f0f0">
                                <TextBox x:Name="MinAgeTextBox" Text="{Binding MinAge}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Background="Transparent" Padding="10,8"/>
                            </Border>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Вместимость" FontSize="12" Margin="5,0,0,5"/>
                            <Border CornerRadius="8" Background="#f0f0f0">
                                <TextBox x:Name="CapacityTextBox" Text="{Binding Capacity}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Background="Transparent" Padding="10,8"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="Статус" FontSize="12" Margin="5,0,0,5"/>
                    <Border CornerRadius="8" Background="#f0f0f0" Margin="0,0,0,15">
                        <ComboBox x:Name="StatusComboBox" SelectedItem="{Binding StatusService}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Background="Transparent" Padding="5,8"/>

                    </Border>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox Grid.Column="0" Content="Пробная услуга" IsChecked="{Binding TrialService}" 
                                  Margin="5,5,0,0" VerticalAlignment="Center" Foreground="#090909"/>
                        <CheckBox Grid.Column="1" Content="Возможность заморозки" IsChecked="{Binding IsFreezable}" 
                                  Margin="5,5,0,0" VerticalAlignment="Center" Foreground="#090909"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Лимит дней заморозки" FontSize="12" Margin="5,0,0,5"/>
                            <Border CornerRadius="8" Background="#f0f0f0">
                                <TextBox x:Name="FreezeDaysLimitTextBox" Text="{Binding FreezeDaysLimit}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Background="Transparent" Padding="10,8"/>
                            </Border>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Количество бонусов" FontSize="12" Margin="5,0,0,5"/>
                            <Border CornerRadius="8" Background="#f0f0f0">
                                <TextBox x:Name="BonusQuantityTextBox" Text="{Binding BonusQuantity}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Background="Transparent" Padding="10,8"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="Описание" FontSize="12" Margin="5,0,0,5"/>
                    <Border CornerRadius="8" Background="#f0f0f0">
                        <TextBox x:Name="DescriptionTextBox" Text="{Binding Description}" Height="80" 
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Background="Transparent" Padding="10,8"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Кнопки действий -->
            <Grid Grid.Row="2" Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Content="Отмена" Grid.Column="1" Margin="5 0" 
                        Height="40" Background="#090909" Foreground="White"
                        BorderThickness="0" 
                        Click="CancelButton_Click"/>
                
                <Button Content="Сохранить" Grid.Column="0" Margin="5 0" 
                        Height="40" Background="#090909" Foreground="White"
                        BorderThickness="0" 
                        Click="SaveButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
