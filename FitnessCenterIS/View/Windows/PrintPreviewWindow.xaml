<Window x:Class="FitnessCenterIS.View.Windows.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Предварительный просмотр печати" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель предварительного просмотра -->
        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,15">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PreviewPanel" Background="White" Margin="15">
                    <!-- Сюда будет добавлен только снимок расписания без дополнительного заголовка -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Панель кнопок -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Печать" Width="120" Height="40" 
                    Background="#090909" Foreground="White" BorderThickness="0"
                    Click="PrintButton_Click"/>
            <Button Content="Отмена" Width="120" Height="40" Margin="10,0,0,0"
                    Background="#090909" Foreground="White" BorderThickness="0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>