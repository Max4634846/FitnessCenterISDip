<Window x:Class="FitnessCenterIS.View.Windows.ClientSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Выбор клиента" Height="500" Width="600"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True">
    <Border Background="#f0f0f0" CornerRadius="15" BorderBrush="#090909" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- Заголовок -->
                <RowDefinition Height="*"/>
                <!-- Основной контент -->
                <RowDefinition Height="60"/>
                <!-- Кнопки внизу -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#f0f0f0" CornerRadius="15">
                <Grid>
                    <TextBlock Text="Выбор клиента" HorizontalAlignment="Left" VerticalAlignment="Center"
                             FontSize="22" FontWeight="SemiBold" Foreground="#333" Margin="20 0 0 0"/>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Поиск -->
                    <RowDefinition Height="*"/>
                    <!-- Список клиентов -->
                </Grid.RowDefinitions>

                <!-- Поиск клиентов -->
                <Grid Grid.Row="0" Margin="0 0 0 15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SearchTextBox" Padding="8 6" BorderThickness="1" 
                           BorderBrush="#ccc" TextChanged="SearchTextBox_TextChanged"
                           Margin="0 0 10 0"
                           />
                    <Button Grid.Column="1" Content="Очистить" Padding="10 6"
                          Background="#999" Foreground="White" BorderThickness="0"
                          Click="ClearSearch_Click"/>
                </Grid>

                <!-- Список клиентов -->
                <DataGrid Grid.Row="1" x:Name="ClientsDataGrid" AutoGenerateColumns="False"
                        BorderThickness="1" BorderBrush="#e0e0e0"
                        IsReadOnly="True"
                        SelectionMode="Single"
                        MouseDoubleClick="ClientsDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Номер карты" Binding="{Binding CardNumber}" Width="120"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" Width="120"/>
                        <DataGridTextColumn Header="Бонусы" Binding="{Binding BonusPoints}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Кнопки внизу -->
            <Border Grid.Row="2" Background="#f0f0f0" CornerRadius="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20 10">
                    <Button x:Name="SelectButton" Click="SelectButton_Click" 
                          Background="#090909" BorderBrush="Transparent" Foreground="White"
                          Height="40" Margin="0 0 10 0" Padding="15 0 15 0">
                        <TextBlock Text="Выбрать"/>
                    </Button>
                    <Button Click="CancelButton_Click" Background="#0f0f0f" 
                          BorderThickness="1" BorderBrush="Transparent" Foreground="White"
                          Height="40" Padding="15 0 15 0">
                        <TextBlock Text="Отмена"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>