<Window x:Class="FitnessCenterIS.View.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitnessCenterIS"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Вход"
        Height="640" Width="1024"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Icon="\Resource\IconFitness.png">
    
    <Grid>

        <Border CornerRadius="10" Background="#fff">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>



                <Border CornerRadius="10 0 0 10" Margin="3">
                    <Border.Background>
                        <ImageBrush ImageSource="/Resource/FitnessFon.jpg" Stretch="UniformToFill"/>
                    </Border.Background>

                    <Button Style="{StaticResource RoundButtonStyle}" 
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="5"
                            Height="25" 
                            Width="25"
                            Background="White"
                            Foreground="#090909"
                            Click="CloseApp_Click">
                        
                        <Icon:MaterialDesign Kind="Close"/>
                        
                    </Button>

                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>

                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="450"/>
                        <RowDefinition  Height="*"/>

                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="ФИТНЕС-ЦЕНТР" FontSize="36"/>
                        </WrapPanel>
                        <WrapPanel Margin="0 25">
                            <Grid Width="350">

                                <TextBlock x:Name="LoginPlaceholder"
                                   Text="Введите логин"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"
                                   Margin="17 0"/>

                                <TextBox x:Name="LoginTextBox" Width="350" 
                                         BorderBrush="Black"
                                         GotFocus="TextBox_GotFocusLogin"
                                         LostFocus="TextBox_LostFocusLogin"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>


                            </Grid>
                        </WrapPanel>

                        <WrapPanel>
                            <Grid Width="350">
                                <TextBlock x:Name="PasswordPlaceholder"
                                       Text="Введите пароль"
                                       Foreground="Gray"
                                       VerticalAlignment="Center"
                                       Margin="17 0"/>

                                <PasswordBox x:Name="PasswordTextBox" 
                                         Width="350" 
                                         Foreground="Black"
                                         BorderBrush="Black"
                                         GotFocus="PasswordBox_GotFocus"
                                         LostFocus="PasswordBox_LostFocus"
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}"/>

                            </Grid>

                        </WrapPanel>

                        <TextBlock Margin="0 10"
                               Text="{Binding ErrorMessage}" 
                               Style="{StaticResource ErrorMessgaeStyle}"/>

                        <Button Content="Войти" Width="350" Height="35" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Background="Black"
                            Foreground="#fff"
                            Margin="0,100,0,0" 
                            Click="Enter_Click"/>

                    </StackPanel>

                </Grid>

            </Grid>
        </Border>

    </Grid>
</Window>
