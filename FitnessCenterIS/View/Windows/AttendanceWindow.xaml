<Window x:Class="FitnessCenterIS.View.Windows.AttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Отметка посещаемости" Height="550" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="15" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3b3b3b" Offset="0"/>
                <GradientStop Color="#6b6b6b" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#f5f5f5" Offset="0"/>
                <GradientStop Color="#e5e5e5" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="Отметка посещаемости" FontSize="22" FontWeight="SemiBold" 
                       VerticalAlignment="Center" Foreground="#333"/>

            <!-- Основное содержимое -->
            <ScrollViewer Grid.Row="1" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Поиск клиента" FontSize="14" Margin="0,0,0,5"/>
                    <Grid>
                        <TextBox x:Name="ClientTextBox" TextChanged="ClientTextBox_TextChanged" Padding="10,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <Popup x:Name="ClientsPopup" PlacementTarget="{Binding ElementName=ClientTextBox}"
                               Placement="Bottom" IsOpen="False" StaysOpen="False" MaxHeight="150">
                            <Border BorderBrush="{StaticResource MaterialDesignDivider}" BorderThickness="1" Background="White">
                                <ListBox x:Name="ClientsListBoxInPopup" SelectionChanged="ClientsListBoxInPopup_SelectionChanged"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock x:Name="LockerInfoTextBlock" Text="" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" 
                               Foreground="#4CAF50" Visibility="Collapsed"/>

                    <TextBlock Text="Абонементы клиента" FontSize="14" Margin="0,0,0,5"/>
                    <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15" Height="200">
                        <ListBox x:Name="SeasonTicketsListBox" Style="{StaticResource MaterialDesignListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="Осталось посещений: "/>
                                            <TextBlock Text="{Binding RemainingVisits}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Border>
                    
                    <TextBlock Text="Услуги абонемента" FontSize="14" Margin="0,0,0,5"/>
                    <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15" Height="150">
                        <ListBox x:Name="ServicesListBox" Style="{StaticResource MaterialDesignListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="Осталось посещений: "/>
                                            <TextBlock Text="{Binding RemainingVisits}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="MarkAttendanceButton" Content="Отметить посещение" Width="180" Height="40" Margin="10,0,0,0"
                        Background="#090909" Foreground="White" BorderThickness="0"
                        Click="MarkAttendance_Click"/>

                <Button x:Name="CompleteAttendanceButton" Content="Завершить посещение" Width="180" Height="40" Margin="10,0,0,0"
                        Background="#FF9800" Foreground="White" BorderThickness="0"
                        Click="CompleteAttendance_Click" Visibility="Collapsed"/>

                <Button Content="Отмена" Width="120" Height="40" Margin="10,0,0,0"
                        Background="#090909" Foreground="White" BorderThickness="0"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
