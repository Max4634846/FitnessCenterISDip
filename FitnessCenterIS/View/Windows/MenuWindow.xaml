<Window x:Class="FitnessCenterIS.View.Windows.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitnessCenterIS.View.Windows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
        mc:Ignorable="d"
        Title="Меню"
        Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        Icon="\Resource\IconFitness.png">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/MenuStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>

        <Border Grid.Column="1" CornerRadius="15" Opacity="0.89"
                MouseDown="Border_MouseDown"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D0D0D" Offset="0"/>
                    <GradientStop Color="#090909" Offset="0.25"/>
                    <GradientStop Color="#5b5b5b" Offset="0.5"/>
                    <GradientStop Color="#090909" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" ></ColumnDefinition>
                    <ColumnDefinition Width="*" ></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="Auto"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="15"></RowDefinition>
                            <RowDefinition Height="50"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" Height="50" Width="190">
                            



                            <WrapPanel HorizontalAlignment="Center">


                                <iconPacks:PackIconMaterial Kind="Run" Width="32" Height="32"
                                                            VerticalAlignment="Center"
                                                            Foreground="#fff"/>

                                <TextBlock Text="Fitness" FontSize="30"
                                           FontWeight="DemiBold"
                                           Foreground="#fff"/>

                            </WrapPanel>

                        </Grid>

                        <Grid Grid.Row="2" Margin="5 30 0 0">
                            <StackPanel>

                                <Expander  Style="{StaticResource TransparentExpander}"  Foreground="#fff" IsExpanded="False" Margin="0 15 0 0">
                                    <Expander.Header>
                                        <WrapPanel Margin="-55,0,-80,0">
                                            <materialDesign:PackIcon Kind="ThunderCircle" Width="20" Height="20"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="#fff"
                                                                        Margin="-0 0 5 0"/>
                                            <TextBlock Text="Быстрые действия" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#fff" Padding="5 0 0 0"/>
                                        </WrapPanel>
                                    </Expander.Header>
                                    <Expander.Content>
                                        <StackPanel Margin="45,0,0,0">
                                            <Button Content="Главная" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="BtnMain_Click"/>
                                        </StackPanel>
                                    </Expander.Content>
                                </Expander>
                                
                                <Expander x:Name="Personal"  Style="{StaticResource TransparentExpander}"  Foreground="#fff" IsExpanded="False" Margin="0 15 0 0">
                                    <Expander.Header>
                                        <WrapPanel Margin="-55,0,-49,0">
                                            <iconPacks:PackIconMaterial Kind="AccountDetails" Width="20" Height="20"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="#fff"
                                                                        Margin="-0 0 5 0"/>
                                            <TextBlock Text="Персонал" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#fff" Padding="5 0 0 0"/>
                                        </WrapPanel>
                                    </Expander.Header>
                                    <Expander.Content>
                                        <StackPanel Margin="45,0,0,0">
                                            <Button Content="Сотрудники" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="Staff_Click"/>
                                            <Button Content="Пользователи" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="User_Click" />
                                            <Button Content="Роли" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="Role_Click"/>
                                        </StackPanel>
                                    </Expander.Content>
                                </Expander>

                                <Expander  Style="{StaticResource TransparentExpander}"  Foreground="#fff" IsExpanded="False" Margin="0 15 0 0">
                                    <Expander.Header>
                                        <WrapPanel Margin="-55,0,-49,0">
                                            <iconPacks:PackIconMaterial Kind="AccountGroup" Width="20" Height="20"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="#fff"
                                                                        Margin="-0 0 5 0"/> 
                                            <TextBlock Text="Клиенты" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#fff" Padding="5 0 0 0"/>
                                        </WrapPanel>
                                    </Expander.Header>
                                    <Expander.Content>
                                        <StackPanel Margin="45,0,0,0">
                                            <Button Content="Клиенты" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="BtnClient_Click"/>
                                            <Button Content="Лиды" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="BtnLead_Click"/>
                                        </StackPanel>
                                    </Expander.Content>
                                </Expander>
                                
                                <Expander  Style="{StaticResource TransparentExpander}"  Foreground="#fff" IsExpanded="False" Margin="0 15 0 0">
                                    <Expander.Header>
                                        <WrapPanel Margin="-55,0,-49,0">
                                            <iconPacks:PackIconMaterial Kind="SelectGroup" Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="#fff"
                                         Margin="-0 0 5 0"/>
                                            <TextBlock Text="Группы" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#fff" Padding="5 0 0 0"/>
                                        </WrapPanel>
                                    </Expander.Header>
                                    <Expander.Content>
                                        <StackPanel Margin="45,0,0,0">
                                            <Button Content="Группы" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="ManageGroupsButton_Click"/>
                                            <Button Content="Клиенты в группах" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="GroupClientsButton_Click"/>
                                        </StackPanel>
                                    </Expander.Content>
                                </Expander>

                                <Expander  Style="{StaticResource TransparentExpander}"  Foreground="#fff" IsExpanded="False" Margin="0 15 0 0">
                                    <Expander.Header>
                                        <WrapPanel Margin="-55,0,-49,0">
                                            <iconPacks:PackIconMaterial Kind="WalletMembership" Width="20" Height="20"
                                        VerticalAlignment="Center"
                                        Foreground="#fff"
                                        Margin="-0 0 5 0"/>
                                            <TextBlock Text="Абонементы" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#fff" Padding="5 0 0 0"/>
                                        </WrapPanel>
                                    </Expander.Header>
                                    <Expander.Content>
                                        <StackPanel Margin="45,0,0,0">
                                            <Button Content="Абонементы" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="SeasonticketBtn_Click"/>
                                            <Button Content="Услуги" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="ServiceBtn_Click"/>
                                        </StackPanel>
                                    </Expander.Content>
                                </Expander>

                                <Expander  Style="{StaticResource TransparentExpander}"  Foreground="#fff" IsExpanded="False" Margin="0 15 0 0">
                                    <Expander.Header>
                                        <WrapPanel Margin="-55,0,-49,0">
                                            <materialDesign:PackIcon Kind="InvoiceTextScheduledOutline" Width="20" Height="20"
                                        VerticalAlignment="Center"
                                        Foreground="#fff"
                                        Margin="-0 0 5 0"/>
                                            <TextBlock Text="Расписание" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#fff" Padding="5 0 0 0"/>
                                        </WrapPanel>
                                    </Expander.Header>
                                    <Expander.Content>
                                        <StackPanel Margin="45,0,0,0">
                                            <Button Content="День" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="ScheduleDay_Click"/>
                                            <Button Content="Неделя" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="ScheduleWeek_Click" />
                                            <Button Content="Месяц" Style="{StaticResource TransparentButton}" Foreground="#fff"  Click="ScheduleMonth_Click"/>
                                        </StackPanel>
                                    </Expander.Content>
                                </Expander>

                                <Expander  Style="{StaticResource TransparentExpander}"  Foreground="#fff" IsExpanded="False" Margin="0 15 0 0">
                                    <Expander.Header>
                                        <WrapPanel Margin="-55,0,-49,0">
                                            <materialDesign:PackIcon Kind="CheckAll" Width="20" Height="20"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#fff"
                                                                      Margin="-0 0 5 0"/>
                                            <TextBlock Text="Посещаемость" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#fff" Padding="5 0 0 0"/>
                                        </WrapPanel>
                                    </Expander.Header>
                                    <Expander.Content>
                                        <StackPanel Margin="45,0,0,0">
                                            <Button Content="История посещений" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="AttendanceHistoryBtn_Click"/>
                                        </StackPanel>
                                    </Expander.Content>
                                </Expander>

                                <Expander  Style="{StaticResource TransparentExpander}"  Foreground="#fff" IsExpanded="False" Margin="0 15 0 0">
                                    <Expander.Header>
                                        <WrapPanel Margin="-55,0,-49,0">
                                            <materialDesign:PackIcon Kind="Money" Width="20" Height="20"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#fff"
                                                                      Margin="0 0 5 0"/>
                                            <TextBlock Text="Продажи" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#fff" Padding="5 0 0 0"/>
                                        </WrapPanel>
                                    </Expander.Header>
                                    <Expander.Content>
                                        <StackPanel Margin="45,0,0,0">
                                            <Button Content="История продаж" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="SalesBtn_Click"/>
                                        </StackPanel>
                                    </Expander.Content>
                                </Expander>

                                <Expander  Style="{StaticResource TransparentExpander}"  Foreground="#fff" IsExpanded="False" Margin="0 15 0 0">
                                    <Expander.Header>
                                        <WrapPanel Margin="-55,0,-49,0">
                                            <materialDesign:PackIcon Kind="DocumentSign" Width="20" Height="20"
                                      VerticalAlignment="Center"
                                      Foreground="#fff"
                                      Margin="0 0 5 0"/>
                                            <TextBlock Text="Отчеты" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#fff" Padding="5 0 0 0"/>
                                        </WrapPanel>
                                    </Expander.Header>
                                    <Expander.Content>
                                        <StackPanel Margin="40,0,0,0">
                                            <Button Content="Общая аналитика" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="AllAnalesBtn_Click"/>
                                            <Button Content="Отчет по финансам" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="FinancialBtn_Click"/>
                                            <Button Content="Отчет по посещаемости" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="AttendanceBtn_Click"/>
                                            <Button Content="Отчет по тренерам" Style="{StaticResource TransparentButton}" Foreground="#fff" Click="TrainerBtn_Click"/>
                                        </StackPanel>
                                    </Expander.Content>
                                </Expander>

                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="Transparent" CornerRadius="0 15 15 0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="PageTitleTextBlock"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="15 0 0 0"
                                   FontSize="16"
                                   Foreground="#fff" />

                        <Border CornerRadius="0 15 0 0" Opacity="0.89">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="LoggedInAdminNameButton"
                                        Content="Александр Машанов"
                                        Click="LoggedInAdminNameButton_Click"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="#fff"
                                        FontSize="14"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="0 0 10 0"/>
                            </Grid>
                        </Border>


                        <Border Grid.Row="1" Background="#fff" CornerRadius="0 0 15 0">
                            <Frame x:Name="MainFrame"
                                   NavigationUIVisibility="Hidden"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Navigated="MainFrame_Navigated" />
                        </Border>


                    </Grid>
                </Border>

            </Grid>

        </Border>
    </Grid>
</Window>