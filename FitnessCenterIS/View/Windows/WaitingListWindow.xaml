<Window x:Class="FitnessCenterIS.View.Windows.WaitingListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:FitnessCenterIS.View.Windows"
        xmlns:model="clr-namespace:FitnessCenterIS.Model"
        Title="Список ожидания" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#f5f5f5">

    <Window.Resources>
        <model:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <model:BoolToVisibilityInvertConverter x:Key="BoolToVisibilityInvertConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Список ожидания" FontSize="24" FontWeight="SemiBold" 
                       VerticalAlignment="Center" Foreground="#333"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="FilterComboBox" Width="150" Height="40" 
                          SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Все записи" IsSelected="True"/>
                    <ComboBoxItem Content="Активные"/>
                    <ComboBoxItem Content="Обработанные"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Список ожидания -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" 
                BorderBrush="#E0E0E0" BorderThickness="1">
            <DataGrid x:Name="WaitingListDataGrid" AutoGenerateColumns="False" 
                     IsReadOnly="True" SelectionMode="Single" 
                     MouseDoubleClick="WaitingListDataGrid_MouseDoubleClick"
                     Background="Transparent" BorderThickness="0"
                     RowBackground="White" AlternatingRowBackground="#F5F5F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="150"/>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceName}" Width="150"/>
                    <DataGridTextColumn Header="Дата запроса" Binding="{Binding EnrollmentDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm}, TargetNullValue='Н/Д'}" Width="120"/>
                    <DataGridTextColumn Header="Запрошенное время" Width="150">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0:dd.MM.yyyy HH:mm} - {1:HH:mm}" TargetNullValue="Не указано">
                                <Binding Path="RequestedStartDateTime"/>
                                <Binding Path="RequestedEndDateTime"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Статус" Width="100">
                        <DataGridTextColumn.Binding>
                            <Binding Path="IsProcessed" Converter="{StaticResource BoolToStatusConverter}"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button x:Name="ProcessButton" Content="Обработать" Width="150" Height="40" 
                   Background="#090909" Foreground="White" BorderThickness="0"
                   Click="ProcessButton_Click"/>
            <Button x:Name="RemoveButton" Content="Удалить" Width="120" Height="40" 
                   Background="#090909" Foreground="White" BorderThickness="0"
                   Margin="10,0,0,0" Click="RemoveButton_Click"/>
            <Button x:Name="CloseButton" Content="Закрыть" Width="120" Height="40" 
                   Background="#090909" Foreground="White" BorderThickness="0"
                   Margin="10,0,0,0" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>