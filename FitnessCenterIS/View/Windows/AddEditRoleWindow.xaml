<Window x:Class="FitnessCenterIS.View.Windows.AddEditRoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Роль"
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="Foreground" Value="#090909"/>
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0 0 0 5"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" BorderBrush="#090909" BorderThickness="1"
            materialDesign:ElevationAssist.Elevation="Dp3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="15 15 0 0" BorderThickness="0 0 0 1" BorderBrush="#e0e0e0">
                <Grid>
                    <TextBlock x:Name="WindowTitle" Text="Новая роль" FontSize="22" FontWeight="SemiBold"
                               Foreground="#333333" VerticalAlignment="Center" Margin="20 0"/>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Информация о роли" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Название роли -->
                    <TextBlock Text="Название" Style="{StaticResource FormLabelStyle}" Margin="0 10 0 5"/>
                    <TextBox x:Name="RoleNameTextBox" 
                             materialDesign:HintAssist.Hint="Введите название роли"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0 0 0 15"/>

                    <!-- Описание роли -->
                    <TextBlock Text="Описание" Style="{StaticResource FormLabelStyle}" Margin="0 10 0 5"/>
                    <TextBox x:Name="RoleDescriptionTextBox" 
                             materialDesign:HintAssist.Hint="Введите описание роли"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Height="100"
                             Margin="0 0 0 15"/>

                    <!-- Скрытое поле для ID роли (используется при редактировании) -->
                    <TextBlock x:Name="RoleIdLabel" Text="ID роли" Visibility="Collapsed"/>
                    <TextBox x:Name="RoleIdTextBox" Visibility="Collapsed" IsReadOnly="True"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки внизу -->
            <Border Grid.Row="2" Background="#f8f9fa" CornerRadius="0 0 15 15" BorderThickness="0 1 0 0" BorderBrush="#e0e0e0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20 10">
                        <Button x:Name="SaveButton" Width="150" Height="40"
                                Background="#090909" Foreground="White" BorderBrush="Transparent"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Click="SaveButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0 0 8 0"/>
                                <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="120" Height="40" Margin="15 0 0 0"
                                Background="#090909" Foreground="White"
                                BorderThickness="1" BorderBrush="Transparent"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Click="CancelButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>