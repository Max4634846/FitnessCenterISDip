<Window x:Class="FitnessCenterIS.View.Windows.SendScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Отправка расписания" Height="550" Width="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border CornerRadius="15" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3b3b3b" Offset="0"/>
                <GradientStop Color="#6b6b6b" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#f5f5f5" Offset="0"/>
                <GradientStop Color="#e5e5e5" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="WindowTitle" Text="Отправка расписания" FontSize="22" FontWeight="SemiBold" 
                           VerticalAlignment="Center" Foreground="#333"/>
                <Button Grid.Column="1" x:Name="CloseButton" Width="30" Height="30" Content="✕" 
                        Click="CloseButton_Click" Background="Transparent" BorderThickness="0"/>
            </Grid>

            <!-- Основное содержимое -->
            <StackPanel Grid.Row="1" Margin="0,20,0,0">

                <!-- Выбор периода -->
                <TextBlock Text="Период расписания" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="SchedulePeriodTextBlock" FontSize="16" FontWeight="Bold" 
                           Margin="0,0,0,15" Foreground="#090909"/>

                <!-- Выбор типа отправки -->
                <TextBlock Text="Кому отправить" FontSize="14" Margin="0,0,0,5"/>
                <ComboBox x:Name="SendTypeComboBox" Width="Auto" HorizontalAlignment="Stretch"
                          Height="40" Padding="10,0" Margin="0,0,0,15"
                          BorderBrush="#E0E0E0" BorderThickness="1"
                          Background="White"
                          SelectionChanged="SendTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Всем группам (кроме индивидуальных)" IsSelected="True"/>
                    <ComboBoxItem Content="Конкретной группе"/>
                    <ComboBoxItem Content="Конкретному клиенту"/>
                </ComboBox>

                <!-- Выбор получателей -->
                <TextBlock x:Name="RecipientLabel" Text="Выберите получателя" FontSize="14" Margin="0,0,0,5"/>
                <ComboBox x:Name="RecipientComboBox" Width="Auto" HorizontalAlignment="Stretch"
                          Height="40" Padding="10,0" Margin="0,0,0,15"
                          BorderBrush="#E0E0E0" BorderThickness="1"
                          Background="White"/>

                <!-- Тема сообщения -->
                <TextBlock Text="Тема сообщения" FontSize="14" Margin="0,0,0,5"/>
                <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15">
                    <TextBox x:Name="SubjectTextBox" Padding="10,8"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                             Text="Расписание занятий"/>
                </Border>

                <!-- Текст сообщения -->
                <TextBlock Text="Текст сообщения" FontSize="14" Margin="0,0,0,5"/>
                <Border CornerRadius="8" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,15">
                    <TextBox x:Name="BodyTextBox" Padding="10,8"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                             AcceptsReturn="True" Height="100" VerticalAlignment="Stretch"
                             Text="Добрый день!&#x0a;&#x0a;Направляем вам расписание занятий на текущую неделю.&#x0a;&#x0a;С уважением,&#x0a;Администрация фитнес-клуба"/>
                </Border>

                <!-- Прогресс бар -->
                <ProgressBar x:Name="ProgressBar" Height="20" Margin="0,0,0,15" 
                             Visibility="Collapsed" IsIndeterminate="True"/>

                <!-- Статус -->
                <TextBlock x:Name="StatusTextBlock" Text="" FontSize="12" Foreground="Green" 
                           Margin="0,0,0,10" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Width="120" Height="40" Margin="0,0,10,0"
                        Background="#090909" Foreground="White" BorderThickness="0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SendButton" Content="Отправить" Width="120" Height="40"
                        Background="#090909" Foreground="White" BorderThickness="0"
                        Click="SendButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>