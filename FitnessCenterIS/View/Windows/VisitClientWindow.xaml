<Window x:Class="FitnessCenterIS.View.Windows.VisitClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitnessCenterIS.View.Windows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Посещение клиента" Height="300" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#f0f0f0" CornerRadius="15" BorderBrush="#090909" BorderThickness="1" Margin="10">
        <TabControl x:Name="VisitTabControl">
            <TabItem Header="Найти по карте">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,10,0,10">
                        <TextBlock Text="Введите номер карты:" FontSize="22" FontWeight="SemiBold" Foreground="#333" />
                        <TextBox x:Name="CardNumberTextBox" materialDesign:HintAssist.Hint="Номер карты" Margin="0,30,0,10"/>

                        <Button Content="Найти профиль" Click="FindClientByCardNumber_Click" 
                                BorderBrush="Transparent" Background="#090909"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>

                        <Button Content="Отмена" Click="Exit_Click" Margin="0 5"
                                BorderBrush="Transparent" Background="#090909"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </StackPanel>
                    
                    

                </Grid>
            </TabItem>

            <TabItem Header="Найти по QR-коду" x:Name="QRCodeTabItem">
                <Grid Margin="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button BorderBrush="Transparent" Background="#090909"
                                Click="StartQRCodeScanButton_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Width="250"
                                Height="50">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="QrCodeScan" Margin="0,0,10,0"/>
                                <TextBlock Text="Отсканировать QR-Код" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Наведите камеру на QR-код клиента." Margin="0,20,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Border>
</Window>