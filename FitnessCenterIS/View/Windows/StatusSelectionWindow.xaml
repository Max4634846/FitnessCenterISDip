<Window x:Class="FitnessCenterIS.View.Windows.StatusSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Выбор статуса" Height="300" Width="400"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True">
    <Border Background="#f0f0f0" CornerRadius="15" BorderBrush="#090909" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- Заголовок -->
                <RowDefinition Height="*"/>
                <!-- Основной контент -->
                <RowDefinition Height="60"/>
                <!-- Кнопки внизу -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#f0f0f0" CornerRadius="15,15,0,0">
                <TextBlock Text="Выбор статуса" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="20" FontWeight="SemiBold" Foreground="#333"/>
            </Border>

            <!-- Основной контент -->
            <StackPanel Grid.Row="1" Margin="30 20">
                <TextBlock Text="Текущий статус:" FontSize="14" Margin="0 0 0 5"/>
                <TextBlock x:Name="CurrentStatusTextBlock" Text="Активна" 
                         FontSize="16" FontWeight="SemiBold" Margin="0 0 0 20"/>

                <TextBlock Text="Выберите новый статус:" FontSize="14" Margin="0 0 0 10"/>
                <ListBox x:Name="StatusListBox" Height="100" 
                       SelectionChanged="StatusListBox_SelectionChanged">
                    <ListBoxItem Content="Активна"/>
                    <ListBoxItem Content="Завершена"/>
                    <ListBoxItem Content="Отменена"/>
                    <ListBoxItem Content="Заморожена"/>
                </ListBox>
            </StackPanel>

            <!-- Кнопки внизу -->
            <Border Grid.Row="2" Background="#f0f0f0" CornerRadius="0,0,15,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20 10">
                    <Button x:Name="SaveButton" Content="Сохранить" Click="SaveButton_Click" 
                          Background="#007bff" Foreground="White" BorderThickness="0"
                          Height="40" Width="120" Margin="0 0 20 0" IsEnabled="False">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Отмена" Click="CancelButton_Click" 
                          Background="#6c757d" Foreground="White" BorderThickness="0"
                          Height="40" Width="120">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>