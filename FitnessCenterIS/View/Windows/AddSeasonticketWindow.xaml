<Window x:Class="FitnessCenterIS.View.Windows.AddSeasonticketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Добавление абонемента" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="15" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3b3b3b" Offset="0"/>
                <GradientStop Color="#6b6b6b" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#f5f5f5" Offset="0"/>
                <GradientStop Color="#e5e5e5" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Заголовок и кнопки управления окном -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="WindowTitle" Text="Новый абонемент" FontSize="22" FontWeight="SemiBold" 
                           Foreground="#333" VerticalAlignment="Center" Margin="20,0,0,0"/>

            </Grid>

            <!-- Основное содержимое -->
            <Grid Grid.Row="1" Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель - информация об абонементе -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Название" FontSize="12" Margin="5,0,0,5"/>
                        <Border CornerRadius="8" Background="#f0f0f0" Margin="0,0,0,15">
                            <TextBox x:Name="NameTextBox" Text="{Binding Name}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Background="Transparent" Padding="10,8"/>
                        </Border>

                        <TextBlock Text="Цена" FontSize="12" Margin="5,0,0,5"/>
                        <Border CornerRadius="8" Background="#f0f0f0" Margin="0,0,0,15">
                            <TextBox x:Name="PriceTextBox" Text="{Binding Price}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Background="Transparent" Padding="10,8" IsReadOnly="True"/>
                        </Border>

                        <TextBlock Text="Срок действия (дней)" FontSize="12" Margin="5,0,0,5"/>
                        <Border CornerRadius="8" Background="#f0f0f0" Margin="0,0,0,15">
                            <TextBox x:Name="DurationTextBox" Text="{Binding ValidityDuration}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Background="Transparent" Padding="10,8"/>
                        </Border>

                        <TextBlock Text="Статус" FontSize="12" Margin="5,0,0,5"/>
                        <Border CornerRadius="8" Background="#f0f0f0" Margin="0,0,0,15">
                            <ComboBox x:Name="StatusComboBox" SelectedItem="{Binding StatusSeasonticket}" 
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Background="Transparent" Padding="5,8">
                                <ComboBoxItem>Активен</ComboBoxItem>
                                <ComboBoxItem>Не активен</ComboBoxItem>
                            </ComboBox>
                        </Border>

                        <TextBlock Text="Описание" FontSize="12" Margin="5,0,0,5"/>
                        <Border CornerRadius="8" Background="#f0f0f0" Margin="0,0,0,15">
                            <TextBox x:Name="DescriptionTextBox" Text="{Binding Description}" Height="80" 
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Background="Transparent" Padding="10,8"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Правая панель - услуги -->
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Доступные услуги -->
                    <TextBlock Grid.Row="0" Text="Доступные услуги" FontWeight="Medium" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" CornerRadius="8" Background="White" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,10">
                        <DataGrid x:Name="ServicesDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" Margin="2" Height="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Width="*" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Цена" Width="100" Binding="{Binding Price, StringFormat=\{0:C\}, ConverterCulture='ru-RU'}"/>
                                <DataGridTextColumn Header="Длительность" Width="120" Binding="{Binding Duration}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Добавление услуги -->
                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Добавить услугу" 
                                Background="#090909" 
                                BorderThickness="0" 
                                Click="AddServiceToSeasonticket_Click"/>

                        <TextBlock Grid.Column="1" Text="Количество посещений:" VerticalAlignment="Center" Margin="15,0,5,0"/>

                        <Border Grid.Column="2" CornerRadius="8" Background="#f0f0f0">
                            <TextBox x:Name="VisitsCountTextBox" Text="1" BorderThickness="0" 
                                     Background="Transparent" Padding="10,8"/>
                        </Border>
                    </Grid>

                    <!-- Услуги в абонементе -->
                    <TextBlock Grid.Row="3" Text="Услуги в абонементе" FontWeight="Medium" Margin="0,0,0,10"/>

                    <Border Grid.Row="4" CornerRadius="8" Background="White" BorderBrush="#ddd" BorderThickness="1">
                        <Grid>
                            <DataGrid x:Name="SeasonticketServicesDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" Margin="2" Height="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название" Width="*" Binding="{Binding Services.Name}"/>
                                    <DataGridTextColumn Header="Цена" Width="100" Binding="{Binding Services.Price, StringFormat=\{0:C\}, ConverterCulture='ru-RU'}"/>
                                    <DataGridTextColumn Header="Количество посещений" Width="150" Binding="{Binding VisitLimit}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Удалить услугу" Background="#090909" Foreground="White"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                    BorderThickness="0" Padding="10,5" Margin="0,0,10,10" 
                                    Click="RemoveServiceFromSeasonticket_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Кнопки действий -->
            <Grid Grid.Row="2" Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Отмена" Grid.Column="1" Margin="5 0" 
                        Height="40" Background="#090909" Foreground="White"
                        BorderThickness="0" 
                        Click="CancelButton_Click"/>

                <Button Content="Сохранить" Grid.Column="0" Margin="5 0" 
                        Height="40" Background="#090909" Foreground="White"
                        BorderThickness="0" 
                        Click="SaveButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
