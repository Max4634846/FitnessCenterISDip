<Page x:Class="FitnessCenterIS.View.Pages.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      mc:Ignorable="d" 
      xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Продажи" 
      d:DesignHeight="800" d:DesignWidth="1280">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Border CornerRadius="0 0 15 15" Margin="10 0 10 0" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#f0f0f0" Margin="10 15" 
                CornerRadius="5"  
                BorderThickness="0 3 0 3">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <WrapPanel VerticalAlignment="Center" Margin="10 0">
                    <!-- Кнопка добавления продажи -->
                    <Button Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Click="NewSale_Click" Margin="0 0 5 0">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AddBox" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <!-- Кнопка удаления продажи -->
                    <Button Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Margin="5 0" Click="DeleteSale_Click">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <!-- Кнопка изменения статуса -->
                    <Button Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Margin="5 0" Click="ChangeSaleStatus_Click">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Edit" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <!-- Поле поиска -->
                    <StackPanel Margin="10">
                        <TextBox x:Name="SearchTextBox" 
                                Width="250" materialDesign:HintAssist.Hint="Найти продажу..."
                                TextChanged="SearchTextBox_TextChanged" Padding="5" 
                                BorderThickness="1" BorderBrush="Gray"
                                Foreground="#090909"
                                Style="{StaticResource MaterialDesignTextBox}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Кнопки справа -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Фильтр по типу продажи -->
                    <ComboBox x:Name="SaleTypeComboBox" Width="150" Margin="5 0"
                              SelectionChanged="SaleTypeComboBox_SelectionChanged"
                              materialDesign:HintAssist.Hint="Тип продажи">
                        <ComboBoxItem Content="Все продажи"/>
                        <ComboBoxItem Content="Абонементы"/>
                        <ComboBoxItem Content="Услуги"/>
                    </ComboBox>

                    <!-- Фильтр по статусу -->
                    <ComboBox x:Name="StatusComboBox" Width="150" Margin="5 0"
                              SelectionChanged="StatusComboBox_SelectionChanged"
                              materialDesign:HintAssist.Hint="Статус">
                        <ComboBoxItem Content="Все статусы"/>
                        <ComboBoxItem Content="Активна"/>
                        <ComboBoxItem Content="Завершена"/>
                        <ComboBoxItem Content="Отменена"/>
                        <ComboBoxItem Content="Заморожена"/>
                    </ComboBox>

                </StackPanel>

                <!-- Таблица продаж -->
                <DataGrid x:Name="SalesDataGrid" Grid.Row="1" 
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent" 
                          SelectionChanged="SalesDataGrid_SelectionChanged"
                          LoadingRow="SalesDataGrid_LoadingRow"
                          MouseDoubleClick="SalesDataGrid_MouseDoubleClick">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding SaleID}" Width="60"/>
                        <DataGridTextColumn Header="Дата продажи" Binding="{Binding SaleDateTime, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="*"/>
                        <DataGridTextColumn Header="Товар/Услуга" Binding="{Binding ServiceName}" Width="*"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding PriceSold, StringFormat={}{0:N2} ₽}" Width="100"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusSale}" Width="100"/>
                        <DataGridTextColumn Header="Тренер" Binding="{Binding TrainerName}" Width="*"/>
                        <DataGridTextColumn Header="Осталось посещений" Binding="{Binding RemainingVisits}" Width="140"/>
                        <DataGridTextColumn Header="Администратор" Binding="{Binding AdministratorName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Нижняя панель статистики -->
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10 0">
                        <TextBlock x:Name="TotalSalesTextBlock" Text="Всего продаж: 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text=" | " VerticalAlignment="Center" Margin="10 0"/>
                        <TextBlock x:Name="TotalAmountTextBlock" Text="Общая сумма: 0.00 ₽" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>