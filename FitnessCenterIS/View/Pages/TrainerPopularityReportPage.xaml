<Page x:Class="FitnessCenterIS.View.Pages.TrainerPopularityReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Популярность тренеров">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и выбор периода -->
        <Border Grid.Row="0" Background="White" Padding="20" Margin="10" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountGroup" Width="30" Height="30" 
                                         VerticalAlignment="Center" Foreground="#090909"/>
                    <TextBlock Text="Популярность тренеров" FontWeight="Bold" FontSize="22" 
                           VerticalAlignment="Center" Margin="10 0 0 0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Период: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <DatePicker x:Name="DateFromPicker" Width="120" Margin="5 0" 
                            SelectedDateChanged="DateRangeChanged"/>
                    <TextBlock Text=" - " VerticalAlignment="Center"/>
                    <DatePicker x:Name="DateToPicker" Width="120" Margin="5 0" 
                            SelectedDateChanged="DateRangeChanged"/>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Margin="15 0 0 0" Padding="10 5" Foreground="#090909" BorderBrush="#090909"
                        Click="ExportReport_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExport" Margin="0 0 5 0"/>
                            <TextBlock Text="Экспорт"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Margin="10 0 0 0" Padding="10 5" Foreground="#090909" BorderBrush="#090909"
                        Click="PrintReport_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Margin="0 0 5 0"/>
                            <TextBlock Text="Печать"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основные показатели -->
        <Border Grid.Row="1" Background="White" Padding="20" Margin="10 0 10 10" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="Ключевые показатели" FontWeight="SemiBold" FontSize="18" Margin="0 0 0 15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Активные тренеры -->
                    <Border Grid.Column="0" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Активные тренеры" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="ActiveTrainersTextBlock" Text="0" FontWeight="Bold" 
                                   FontSize="24" Foreground="#4285F4" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Количество продаж тренеров -->
                    <Border Grid.Column="1" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Продажи тренеров" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="TrainerSalesCountTextBlock" Text="0" FontWeight="Bold" 
                                   FontSize="24" Foreground="#0F9D58" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Выручка через тренеров -->
                    <Border Grid.Column="2" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Выручка тренеров" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="TrainerRevenueTextBlock" Text="0 ₽" FontWeight="Bold" 
                                   FontSize="24" Foreground="#DB4437" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Тренировки по записи -->
                    <Border Grid.Column="3" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Тренировки по записи" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="ScheduledTrainingsTextBlock" Text="0" FontWeight="Bold" 
                                   FontSize="24" Foreground="#F4B400" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Средняя стоимость услуг тренера -->
                    <Border Grid.Column="4" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Средняя стоимость" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="AverageTrainerServicePriceTextBlock" Text="0 ₽" FontWeight="Bold" 
                                   FontSize="24" Foreground="#7B1FA2" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Самый популярный тренер -->
                    <Border Grid.Column="5" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Топ тренер" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="TopTrainerTextBlock" Text="Н/Д" FontWeight="Bold" 
                                   FontSize="20" Foreground="#0288D1" Margin="0 10 0 0"
                                   TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Графики данных -->
        <Grid Grid.Row="2" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- График продаж тренеров -->
            <Border Grid.Column="0" Background="White" Padding="20" Margin="0 0 5 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Динамика продаж тренеров" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="TrainerSalesChartContainer" Height="250"/>
                </StackPanel>
            </Border>

            <!-- График распределения услуг по тренерам -->
            <Border Grid.Column="1" Background="White" Padding="20" Margin="5 0 0 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Распределение услуг по тренерам" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="TrainerServiceDistributionContainer" Height="250"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Нижние графики -->
        <Grid Grid.Row="3" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Рейтинг тренеров -->
            <Border Grid.Column="0" Background="White" Padding="20" Margin="0 0 5 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Рейтинг тренеров" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="TrainerRatingChartContainer" Height="250"/>
                </StackPanel>
            </Border>

            <!-- График посещаемости тренеров -->
            <Border Grid.Column="1" Background="White" Padding="20" Margin="5 0 0 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Посещаемость тренеров" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="TrainerAttendanceChartContainer" Height="250"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>