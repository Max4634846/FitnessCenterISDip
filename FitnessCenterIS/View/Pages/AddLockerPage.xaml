<Page x:Class="FitnessCenterIS.View.Pages.AddLockerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Управление шкафчиками"
      Loaded="AddLockerPage_Loaded">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Foreground" Value="#090909"/>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Основное содержимое -->
        <Border Grid.Row="1" Background="#f0f0f0" Margin="10 15" 
                CornerRadius="5" BorderThickness="0 3 0 3" BorderBrush="#e0e0e0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Форма добавления шкафчика -->
                <Border Grid.Row="0" Background="White" Margin="15,15,15,10" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="FormHeaderTextBlock" Text="Добавить новый шкафчик" 
                                   FontSize="18" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Номер ключа -->
                            <StackPanel Grid.Column="0">
                                <TextBox x:Name="KeyNumberTextBox" 
                                         materialDesign:HintAssist.Hint="Номер ключа *"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         MaxLength="50" Margin="0,5"/>
                            </StackPanel>

                            <!-- Тип раздевалки -->
                            <StackPanel Grid.Column="2">
                                <ComboBox x:Name="LockerRoomTypeComboBox"
                                          materialDesign:HintAssist.Hint="Тип раздевалки *"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          DisplayMemberPath="Name" Margin="0,5"/>
                            </StackPanel>
                        </Grid>

                        <!-- Валидационные сообщения -->
                        <TextBlock x:Name="ValidationTextBlock" Foreground="Red" 
                                   Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Панель управления -->
                <WrapPanel Grid.Row="1" VerticalAlignment="Center" Margin="15,0,15,0">

                    <Button x:Name="AddButton" Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Click="AddButton_Click" Margin="0,0,5,0"
                            ToolTip="Добавить шкафчик">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AddBox" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button x:Name="UpdateButton" Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Click="UpdateButton_Click" Margin="5,0"
                            Visibility="Collapsed" ToolTip="Обновить шкафчик">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Update" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button x:Name="DeleteButton" Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Click="DeleteButton_Click" Margin="5,0"
                            ToolTip="Удалить шкафчик">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button x:Name="ClearButton" Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Click="ClearButton_Click" Margin="5,0"
                            ToolTip="Очистить форму">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Refresh" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <StackPanel Margin="15,0">
                        <TextBox x:Name="SearchTextBox" 
                                 Width="250" materialDesign:HintAssist.Hint="Найти шкафчик..."
                                 TextChanged="SearchTextBox_TextChanged" Padding="5" 
                                 BorderThickness="1" BorderBrush="Gray"
                                 Foreground="#090909"
                                 Style="{StaticResource MaterialDesignTextBox}"/>
                    </StackPanel>

      

                </WrapPanel>

                <!-- DataGrid для шкафчиков -->
                <DataGrid x:Name="LockersDataGrid" Grid.Row="2" 
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent" 
                          SelectionChanged="LockersDataGrid_SelectionChanged"
                          LoadingRow="LockersDataGrid_LoadingRow"
                          Margin="15,0,15,15">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер ключа" Binding="{Binding KeyNumber}" Width="*"/>
                        <DataGridTextColumn Header="Тип раздевалки" Binding="{Binding LockerRoomTypeName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>
    </Grid>
</Page>
