<Page x:Class="FitnessCenterIS.View.Pages.AttendanceHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      xmlns:model="clr-namespace:FitnessCenterIS.Model"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="История посещений">

    <Grid>

        <!-- Панель фильтров -->
        <Border Grid.Row="0" Background="#f0f0f0" Margin="10 15" 
                CornerRadius="5" BorderThickness="1">

            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel VerticalAlignment="Center" Margin="10 10">
                    <TextBox x:Name="SearchTextBox" Width="300" Margin="0 0 20 0"
                             materialDesign:HintAssist.Hint="Поиск по имени"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <DatePicker x:Name="StartDatePicker" Margin="0 0 20 0"
                                materialDesign:HintAssist.Hint="Дата с"  SelectedDateChanged="DatePicker_SelectedDateChanged" />

                    <DatePicker x:Name="EndDatePicker" Margin="0 0 20 0"
                                materialDesign:HintAssist.Hint="Дата по"  SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                    
                </WrapPanel>

            <DataGrid x:Name="AttendanceDataGrid" Grid.Row="1" AutoGenerateColumns="False"
                      ItemsSource="{Binding Attendances}" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      Background="Transparent" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding UserType}" Width="100"/>
                            <DataGridTextColumn Header="Дата входа" 
                                  Binding="{Binding EntryDateTime, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Дата выхода" 
                                  Binding="{Binding ExitDateTime, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Шкафчик" Binding="{Binding LockerNumber}" Width="100"/>
                        </DataGrid.Columns>
            </DataGrid>

            </Grid>
        </Border>

    </Grid>
</Page>
