<Page x:Class="FitnessCenterIS.View.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      xmlns:model="clr-namespace:FitnessCenterIS.Model"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="Главная">

    <Page.Resources>
        <model:PriorityToColorConverter x:Key="PriorityToColorConverter"/>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="15 10"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок "Быстрые действия" -->
        <Border Grid.Row="0" Background="White" Padding="25 20" Margin="20 20 20 0" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="10"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="LightningBolt" Width="24" Height="24" 
                                         VerticalAlignment="Center" Foreground="#090909"/>
                    <TextBlock Text="Быстрые действия" FontWeight="SemiBold" VerticalAlignment="Center" 
                           Margin="10 0 0 0" FontSize="20" Foreground="#333333"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Панель быстрых действий -->
        <Border Grid.Row="1" Background="White" Padding="20" Margin="10 15 10 0" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="10"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <WrapPanel HorizontalAlignment="Left">
                <Button Style="{StaticResource ActionButtonStyle}" Click="AddNewClientButton_Click">
                    <StackPanel>
                        <iconPacks:PackIconMaterial Kind="AccountPlus" Width="40" Height="40" 
                                               HorizontalAlignment="Center" Foreground="#090909"/>
                        <TextBlock Text="Новый клиент" HorizontalAlignment="Center" 
                               Margin="0 10 0 0" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButtonStyle}" Click="NewLeadButton_Click">
                    <StackPanel>
                        <iconPacks:PackIconMaterial Kind="AccountCheck" Width="40" Height="40" 
                                               HorizontalAlignment="Center" Foreground="#090909"/>
                        <TextBlock Text="Новый лид" HorizontalAlignment="Center" 
                               Margin="0 10 0 0" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButtonStyle}" Click="NewSaleBtn_Click">
                    <StackPanel>
                        <iconPacks:PackIconMaterial Kind="Cash" Width="40" Height="40" 
                                               HorizontalAlignment="Center" Foreground="#090909"/>
                        <TextBlock Text="Новая продажа" HorizontalAlignment="Center" 
                               Margin="0 10 0 0" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButtonStyle}" Click="VisitBtn_Click">
                    <StackPanel>
                        <iconPacks:PackIconMaterialDesign Kind="Visibility" Width="40" Height="40" 
                                                     HorizontalAlignment="Center" Foreground="#090909"/>
                        <TextBlock Text="Поиск профиля" HorizontalAlignment="Center" 
                               Margin="0 10 0 0" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButtonStyle}" Click="AttendanceBtn_Click">
                    <StackPanel>
                        <iconPacks:PackIconMaterialDesign Kind="Markunread" Width="40" Height="40" 
                                                     HorizontalAlignment="Center" Foreground="#090909"/>
                        <TextBlock Text="Посещаемость" HorizontalAlignment="Center" 
                               Margin="0 10 0 0" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
                
                <Button Style="{StaticResource ActionButtonStyle}">
                    <StackPanel>
                        <iconPacks:PackIconMaterialDesign Kind="DocumentScannerOutline" Width="40" Height="40" 
                                     HorizontalAlignment="Center" Foreground="#090909"/>
                        <TextBlock Text="Отчеты" HorizontalAlignment="Center" 
               Margin="0 10 0 0" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Заголовок и кнопки задач -->
        <Border Grid.Row="2" Background="White" Padding="20" Margin="20 15 20 0" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="10"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarTask" Width="24" Height="24" 
                                         VerticalAlignment="Center" Foreground="#090909"/>
                    <TextBlock Text="Задачи" FontWeight="SemiBold" VerticalAlignment="Center" 
                           Margin="10 0 0 0" FontSize="20" Foreground="#333333"/>
                </StackPanel>
                
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Padding="15 8" Foreground="#090909" BorderBrush="#090909"
                        Click="OpenWinTask_Click">
                        <StackPanel Orientation="Horizontal" >
                            <materialDesign:PackIcon Kind="Plus" Margin="0 0 8 0"/>
                            <TextBlock Text="Новая задача" Margin="0 -2 0 0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Фильтры задач и список задач -->
        <Border Grid.Row="3" Background="White" Padding="20" Margin="20 15 20 20" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="10"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Фильтры задач -->
                <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0 0 0 15">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                        <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0 0 10 0" FontWeight="Medium"/>
                        <Button x:Name="NewTasksButton" Style="{StaticResource MaterialDesignFlatButton}"
                Content="Новые (0)" Foreground="#090909" Click="FilterTasksByStatus_Click" Tag="1"/>
                        <Button x:Name="InProgressTasksButton" Style="{StaticResource MaterialDesignFlatButton}"
                Content="В работе (0)" Margin="10 0 0 0" Foreground="#333333" Click="FilterTasksByStatus_Click" Tag="2"/>
                        <Button x:Name="CompletedTasksButton" Style="{StaticResource MaterialDesignFlatButton}"
                Content="Завершенные (0)" Margin="10 0 0 0" Foreground="#333333" Click="FilterTasksByStatus_Click" Tag="3"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Приоритет:" VerticalAlignment="Center" Margin="0 0 10 0" FontWeight="Medium"/>
                        <Button x:Name="HighPriorityButton" Style="{StaticResource MaterialDesignFlatButton}"
                Content="Высокий (0)" Foreground="#D32F2F" Click="FilterTasksByPriority_Click" Tag="Высокий"/>
                        <Button x:Name="MediumPriorityButton" Style="{StaticResource MaterialDesignFlatButton}"
                Content="Средний (0)" Margin="10 0 0 0" Foreground="#FB8C00" Click="FilterTasksByPriority_Click" Tag="Средний"/>
                        <Button x:Name="LowPriorityButton" Style="{StaticResource MaterialDesignFlatButton}"
                Content="Низкий (0)" Margin="10 0 0 0" Foreground="#388E3C" Click="FilterTasksByPriority_Click" Tag="Низкий"/>
                        <Button x:Name="AllPrioritiesButton" Style="{StaticResource MaterialDesignFlatButton}"
                Content="Все" Margin="10 0 0 0" Foreground="#333333" Click="FilterTasksByPriority_Click" Tag="All"/>
                    </StackPanel>
                </StackPanel>

                <!-- Список задач -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="TasksListBox" ItemsSource="{Binding}" Background="Transparent" BorderThickness="0"
                         SelectionChanged="TasksListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0 0 0 10"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
                                                CornerRadius="8" Padding="15">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Border Grid.Column="0" Width="5" CornerRadius="2"
                                                        Background="{Binding TaskPrioritie, Converter={StaticResource PriorityToColorConverter}}" 
                                                        Margin="0 0 15 0"/>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" 
                                                               FontSize="16" Foreground="#333333"/>
                                                        <TextBlock Text="{Binding TaskPrioritie}" 
                                                               FontStyle="Italic" Foreground="#757575" 
                                                               Margin="0 5 0 0"/>
                                                        <TextBlock Text="{Binding EndDedlainDateTime, StringFormat=dd.MM.yyyy HH:mm}" 
                                                               Foreground="#9E9E9E" Margin="0 5 0 0"/>
                                                        <TextBlock Text="{Binding Client}" Foreground="#333333" 
                                                               Margin="0 10 0 0" FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding Description}" 
                                                               Foreground="#616161" Margin="0 5 0 0"
                                                               TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#E8F0FE"/>
                                                    <Setter Property="BorderBrush" Value="#4285F4"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
