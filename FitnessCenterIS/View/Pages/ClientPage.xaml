<Page x:Class="FitnessCenterIS.View.Pages.ClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Клиенты">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        
        <Border CornerRadius="0 0 15 15" Margin="10 0 10 0" >

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

            </Grid>

        </Border>

        <Border Grid.Row="1" Background="#f0f0f0" Margin="10 15" 
             CornerRadius="5"  
             BorderThickness="0 3 0 3">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>


                <WrapPanel VerticalAlignment="Center" Margin="10 0">

                    <Button Foreground="#fff" Background="#090909" 
                         BorderBrush="Transparent" Click="OpenWinClient_Click" Margin="0 0 5 0">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AddBox" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button Width="50" Foreground="#fff" Background="#090909" 
                         BorderBrush="Transparent" Margin="5 0" Click="DeleteClient_Click">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon  Kind="Delete" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button Width="50" Foreground="#fff" Background="#090909" 
                         BorderBrush="Transparent" Margin="5 0" Click="EditClient_Click">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon  Kind="Edit" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button Width="50" Foreground="#fff" Background="#090909" 
                         BorderBrush="Transparent" Click="QRCodeOpenScan_Click" Margin="5 0">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon  Kind="QrcodeScan" Height="20"/>
                        </WrapPanel>
                    </Button>

                    
                    <StackPanel Margin="10">
                        <TextBox x:Name="SearchTextBox" 
                                 Width="250"  materialDesign:HintAssist.Hint="Найти клиента..."
                                 TextChanged="SearchTextBox_TextChanged" Padding="5" 
                                 BorderThickness="1" BorderBrush="Gray"
                                 Foreground="#090909"
                                 Style="{StaticResource MaterialDesignTextBox}"/>
                    </StackPanel>


                </WrapPanel>

                <Button Width="200" Background="#5b5b5b" Foreground="#fff" BorderBrush="Transparent" HorizontalAlignment="Right" 
                     Margin="0 0 5 0" Click="SendQRCodeButton_Click">
                    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon  Kind="QrcodeRemove" Height="20"/>
                        <TextBlock Text="Отправить QRCode" Margin="10 0"/>
                    </WrapPanel>
                </Button>
                




                <DataGrid   x:Name="BDPeople" Grid.Row="1" 
                            EnableRowVirtualization="True"
                            EnableColumnVirtualization="True"
                            HeadersVisibility="Column"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            Background="Transparent" SelectionChanged="BDPeople_SelectionChanged"
                            LoadingRow="BDPeople_LoadingRow"
                            MouseDoubleClick="ClientsDataGrid_MouseDoubleClick">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Фамилия" Binding="{Binding Surname}" Width="*"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="*"/>
                        <DataGridTextColumn Header="Дата рождения" Binding="{Binding DateOfBirth, StringFormat=\{0:dd.MM.yyyy\}}" Width="*"/>
                        <DataGridTextColumn Header="Пол" Binding="{Binding Gender}" Width="*"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" Width="*"/>
                        <DataGridTextColumn Header="Почта" Binding="{Binding Email}" Width="*"/>
                        <DataGridTemplateColumn Header="QR Code" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding QRCode}" Width="50" Height="50" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
