<Page x:Class="FitnessCenterIS.View.Pages.Reports.DashboardReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages.Reports"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Общая аналитика">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и выбор периода -->
        <Border Grid.Row="0" Background="White" Padding="20" Margin="10" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartLine" Width="30" Height="30" 
                                         VerticalAlignment="Center" Foreground="#090909"/>
                    <TextBlock Text="Общая аналитика" FontWeight="Bold" FontSize="22" 
                           VerticalAlignment="Center" Margin="10 0 0 0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Период: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <DatePicker x:Name="DateFromPicker" Width="120" Margin="5 0" 
                            SelectedDateChanged="DateRangeChanged"/>
                    <TextBlock Text=" - " VerticalAlignment="Center"/>
                    <DatePicker x:Name="DateToPicker" Width="120" Margin="5 0" 
                            SelectedDateChanged="DateRangeChanged"/>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Margin="15 0 0 0" Padding="10 5" Foreground="#090909" BorderBrush="#090909"
                        Click="ExportToWord_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileWord" Margin="0 0 5 0"/>
                            <TextBlock Text="Экспорт в Word"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основные показатели -->
        <Border Grid.Row="1" Background="White" Padding="20" Margin="10 0 10 10" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="Ключевые показатели деятельности" FontWeight="SemiBold" FontSize="18" Margin="0 0 0 15"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Первая строка показателей -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Общая выручка -->
                        <Border Grid.Column="0" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Общая выручка" FontWeight="Medium" FontSize="14"/>
                                <TextBlock x:Name="TotalRevenueTextBlock" Text="0 ₽" FontWeight="Bold" 
                                       FontSize="24" Foreground="#4285F4" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Border>

                        <!-- Активные клиенты -->
                        <Border Grid.Column="1" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Активные клиенты" FontWeight="Medium" FontSize="14"/>
                                <TextBlock x:Name="ActiveClientsTextBlock" Text="0" FontWeight="Bold" 
                                       FontSize="24" Foreground="#0F9D58" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Border>

                        <!-- Посещения -->
                        <Border Grid.Column="2" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Посещения" FontWeight="Medium" FontSize="14"/>
                                <TextBlock x:Name="TotalVisitsTextBlock" Text="0" FontWeight="Bold" 
                                       FontSize="24" Foreground="#DB4437" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Border>

                        <!-- Средняя загрузка -->
                        <Border Grid.Column="3" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Средняя загрузка" FontWeight="Medium" FontSize="14"/>
                                <TextBlock x:Name="AverageLoadTextBlock" Text="0%" FontWeight="Bold" 
                                       FontSize="24" Foreground="#F4B400" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Вторая строка показателей -->
                    <Grid Grid.Row="1" Margin="0 10 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Новые клиенты -->
                        <Border Grid.Column="0" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Новые клиенты" FontWeight="Medium" FontSize="14"/>
                                <TextBlock x:Name="NewClientsTextBlock" Text="0" FontWeight="Bold" 
                                       FontSize="24" Foreground="#7B1FA2" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Border>

                        <!-- Активные абонементы -->
                        <Border Grid.Column="1" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Активные абонементы" FontWeight="Medium" FontSize="14"/>
                                <TextBlock x:Name="ActiveMembershipsTextBlock" Text="0" FontWeight="Bold" 
                                       FontSize="24" Foreground="#0288D1" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Border>

                        <!-- Проведено тренировок -->
                        <Border Grid.Column="2" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Проведено тренировок" FontWeight="Medium" FontSize="14"/>
                                <TextBlock x:Name="CompletedTrainingsTextBlock" Text="0" FontWeight="Bold" 
                                       FontSize="24" Foreground="#FF5722" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Border>

                        <!-- Коэффициент удержания -->
                        <Border Grid.Column="3" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Коэффициент удержания" FontWeight="Medium" FontSize="14"/>
                                <TextBlock x:Name="RetentionRateTextBlock" Text="0%" FontWeight="Bold" 
                                       FontSize="24" Foreground="#795548" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Графики данных -->
        <Grid Grid.Row="2" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- График посещаемости по дням -->
            <Border Grid.Column="0" Background="White" Padding="20" Margin="0 0 5 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Посещаемость по дням" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="DailyVisitsChartContainer" Height="250"/>
                </StackPanel>
            </Border>

            <!-- График популярных услуг -->
            <Border Grid.Column="1" Background="White" Padding="20" Margin="5 0 0 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Популярные услуги" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="PopularServicesChartContainer" Height="250"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Нижние графики -->
        <Grid Grid.Row="3" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- График возрастного распределения клиентов -->
            <Border Grid.Column="0" Background="White" Padding="20" Margin="0 0 5 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Возрастное распределение клиентов" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="AgeDistributionChartContainer" Height="250"/>
                </StackPanel>
            </Border>

            <!-- График загруженности по часам -->
            <Border Grid.Column="1" Background="White" Padding="20" Margin="5 0 0 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Загруженность по часам" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="HourlyLoadChartContainer" Height="250"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
