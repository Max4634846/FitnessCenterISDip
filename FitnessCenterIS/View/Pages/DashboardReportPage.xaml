<Page x:Class="FitnessCenterIS.View.Pages.DashboardReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Сводный отчет">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и выбор периода -->
        <Border Grid.Row="0" Background="White" Padding="20" Margin="10" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartLineVariant" Width="30" Height="30" 
                                         VerticalAlignment="Center" Foreground="#090909"/>
                    <TextBlock Text="Сводный отчет" FontWeight="Bold" FontSize="22" 
                           VerticalAlignment="Center" Margin="10 0 0 0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Период: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <DatePicker x:Name="DateFromPicker" Width="120" Margin="5 0" 
                            SelectedDateChanged="DateRangeChanged"/>
                    <TextBlock Text=" - " VerticalAlignment="Center"/>
                    <DatePicker x:Name="DateToPicker" Width="120" Margin="5 0" 
                            SelectedDateChanged="DateRangeChanged"/>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Margin="15 0 0 0" Padding="10 5" Foreground="#090909" BorderBrush="#090909"
                        Click="ExportReport_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExport" Margin="0 0 5 0"/>
                            <TextBlock Text="Экспорт"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Margin="10 0 0 0" Padding="10 5" Foreground="#090909" BorderBrush="#090909"
                        Click="PrintReport_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Margin="0 0 5 0"/>
                            <TextBlock Text="Печать"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основные показатели -->
        <Border Grid.Row="1" Background="White" Padding="20" Margin="10 0 10 10" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="Ключевые показатели" FontWeight="SemiBold" FontSize="18" Margin="0 0 0 15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Активные клиенты -->
                    <Border Grid.Column="0" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Активные клиенты" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="ActiveClientsTextBlock" Text="0" FontWeight="Bold" 
                                   FontSize="24" Foreground="#4285F4" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Количество продаж -->
                    <Border Grid.Column="1" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Кол-во продаж" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="SalesCountTextBlock" Text="0" FontWeight="Bold" 
                                   FontSize="24" Foreground="#0F9D58" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Общая выручка -->
                    <Border Grid.Column="2" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Общая выручка" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="TotalRevenueTextBlock" Text="0 ₽" FontWeight="Bold" 
                                   FontSize="24" Foreground="#DB4437" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Посещения -->
                    <Border Grid.Column="3" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Посещения" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="VisitsCountTextBlock" Text="0" FontWeight="Bold" 
                                   FontSize="24" Foreground="#F4B400" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Средний чек -->
                    <Border Grid.Column="4" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Средний чек" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="AverageCheckTextBlock" Text="0 ₽" FontWeight="Bold" 
                                   FontSize="24" Foreground="#7B1FA2" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Абонементы -->
                    <Border Grid.Column="5" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Абонементы" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="MembershipSalesTextBlock" Text="0" FontWeight="Bold" 
                                   FontSize="24" Foreground="#0288D1" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Услуги -->
                    <Border Grid.Column="6" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Услуги" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="ServiceSalesTextBlock" Text="0" FontWeight="Bold" 
                                   FontSize="24" Foreground="#FF5722" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Графики данных -->
        <Grid Grid.Row="2" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- График продаж -->
            <Border Grid.Column="0" Background="White" Padding="20" Margin="0 0 5 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Динамика выручки" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="SalesChartContainer" Height="250"/>
                </StackPanel>
            </Border>

            <!-- График регистрации клиентов -->
            <Border Grid.Column="1" Background="White" Padding="20" Margin="5 0 0 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Динамика регистраций" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="ClientRegistrationChartContainer" Height="250"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Нижние графики -->
        <Grid Grid.Row="3" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- График популярности услуг -->
            <Border Grid.Column="0" Background="White" Padding="20" Margin="0 0 5 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Популярность услуг" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="ServicePopularityChartContainer" Height="250"/>
                </StackPanel>
            </Border>

            <!-- График посещаемости по дням недели -->
            <Border Grid.Column="1" Background="White" Padding="20" Margin="5 0 0 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Посещаемость по дням недели" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="AttendanceChartContainer" Height="250"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>