<Page x:Class="FitnessCenterIS.View.Pages.AddRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Управление комнатами"
      Loaded="AddRoomPage_Loaded">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Foreground" Value="#090909"/>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Основное содержимое -->
        <Border Grid.Row="1" Background="#f0f0f0" Margin="10 15" 
                CornerRadius="5" BorderThickness="0 3 0 3" BorderBrush="#e0e0e0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Форма добавления комнаты -->
                <Border Grid.Row="0" Background="White" Margin="15,15,15,10" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="FormHeaderTextBlock" Text="Добавить новую комнату" 
                                   FontSize="18" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Название комнаты -->
                            <StackPanel Grid.Column="0">
                                <TextBox x:Name="RoomNameTextBox" 
                                         materialDesign:HintAssist.Hint="Название комнаты *"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         MaxLength="150" Margin="0,5"/>
                            </StackPanel>

                            <!-- Описание комнаты -->
                            <StackPanel Grid.Column="2">
                                <TextBox x:Name="RoomDescriptionTextBox" 
                                         materialDesign:HintAssist.Hint="Описание комнаты (необязательно)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Margin="0,5"/>
                            </StackPanel>
                        </Grid>

                        <!-- Валидационные сообщения -->
                        <TextBlock x:Name="ValidationTextBlock" Foreground="Red" 
                                   Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Панель управления -->
                <WrapPanel Grid.Row="1" VerticalAlignment="Center" Margin="15,0,15,0">

                    <Button x:Name="AddButton" Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Click="AddButton_Click" Margin="0,0,5,0"
                            ToolTip="Добавить комнату">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AddBox" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button x:Name="UpdateButton" Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Click="UpdateButton_Click" Margin="5,0"
                            Visibility="Collapsed" ToolTip="Обновить комнату">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Update" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button x:Name="DeleteButton" Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Click="DeleteButton_Click" Margin="5,0"
                            ToolTip="Удалить комнату">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button x:Name="ClearButton" Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Click="ClearButton_Click" Margin="5,0"
                            ToolTip="Очистить форму">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Refresh" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <StackPanel Margin="15,0">
                        <TextBox x:Name="SearchTextBox" 
                                 Width="250" materialDesign:HintAssist.Hint="Найти комнату..."
                                 TextChanged="SearchTextBox_TextChanged" Padding="5" 
                                 BorderThickness="1" BorderBrush="Gray"
                                 Foreground="#090909"
                                 Style="{StaticResource MaterialDesignTextBox}"/>
                    </StackPanel>

                </WrapPanel>

                <!-- DataGrid для комнат -->
                <DataGrid x:Name="RoomsDataGrid" Grid.Row="2" 
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent" 
                          SelectionChanged="RoomsDataGrid_SelectionChanged"
                          LoadingRow="RoomsDataGrid_LoadingRow"
                          Margin="15,0,15,15">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                        <DataGridTemplateColumn Header="Статус" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2ecc71"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                                        <Setter Property="Background" Value="#e74c3c"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Свободна"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                                                <Setter Property="Text" Value="Используется"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ActiveSchedulesCount, StringFormat=' ({0})'}" 
                                                       Foreground="White" FontSize="10" VerticalAlignment="Center"
                                                       Visibility="{Binding IsInUse, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>
    </Grid>
</Page>
