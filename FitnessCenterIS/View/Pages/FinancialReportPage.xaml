<Page x:Class="FitnessCenterIS.View.Pages.Reports.FinancialReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages.Reports"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Финансовый отчет">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и выбор периода -->
        <Border Grid.Row="0" Background="White" Padding="20" Margin="10" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CurrencyUsd" Width="30" Height="30" 
                                         VerticalAlignment="Center" Foreground="#090909"/>
                    <TextBlock Text="Финансовый отчет" FontWeight="Bold" FontSize="22" 
                           VerticalAlignment="Center" Margin="10 0 0 0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Период: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <DatePicker x:Name="DateFromPicker" Width="120" Margin="5 0" 
                            SelectedDateChanged="DateRangeChanged"/>
                    <TextBlock Text=" - " VerticalAlignment="Center"/>
                    <DatePicker x:Name="DateToPicker" Width="120" Margin="5 0" 
                            SelectedDateChanged="DateRangeChanged"/>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Margin="15 0 0 0" Padding="10 5" Foreground="#090909" BorderBrush="#090909"
                        Click="ExportToWord_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileWord" Margin="0 0 5 0"/>
                            <TextBlock Text="Экспорт в Word"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основные показатели -->
        <Border Grid.Row="1" Background="White" Padding="20" Margin="10 0 10 10" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="Ключевые финансовые показатели" FontWeight="SemiBold" FontSize="18" Margin="0 0 0 15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Общая выручка -->
                    <Border Grid.Column="0" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Общая выручка" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="TotalRevenueTextBlock" Text="0 ₽" FontWeight="Bold" 
                                   FontSize="24" Foreground="#4285F4" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Количество продаж -->
                    <Border Grid.Column="1" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Продажи" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="TotalSalesTextBlock" Text="0" FontWeight="Bold" 
                                   FontSize="24" Foreground="#0F9D58" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Средний чек -->
                    <Border Grid.Column="2" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Средний чек" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="AverageCheckTextBlock" Text="0 ₽" FontWeight="Bold" 
                                   FontSize="24" Foreground="#DB4437" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Общие платежи -->
                    <Border Grid.Column="3" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Платежи" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="TotalPaymentsTextBlock" Text="0 ₽" FontWeight="Bold" 
                                   FontSize="24" Foreground="#F4B400" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Скидки -->
                    <Border Grid.Column="4" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Скидки" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="TotalDiscountsTextBlock" Text="0 ₽" FontWeight="Bold" 
                                   FontSize="24" Foreground="#7B1FA2" Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Лучший день -->
                    <Border Grid.Column="5" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Лучший день" FontWeight="Medium" FontSize="14"/>
                            <TextBlock x:Name="BestDayTextBlock" Text="Н/Д" FontWeight="Bold" 
                                   FontSize="20" Foreground="#0288D1" Margin="0 10 0 0"
                                   TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Графики данных -->
        <Grid Grid.Row="2" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- График выручки по дням -->
            <Border Grid.Column="0" Background="White" Padding="20" Margin="0 0 5 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Выручка по дням" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="DailyRevenueChartContainer" Height="250"/>
                </StackPanel>
            </Border>

            <!-- График способов оплаты -->
            <Border Grid.Column="1" Background="White" Padding="20" Margin="5 0 0 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Способы оплаты" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="PaymentMethodsChartContainer" Height="250"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Нижние графики -->
        <Grid Grid.Row="3" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- График продаж по услугам -->
            <Border Grid.Column="0" Background="White" Padding="20" Margin="0 0 5 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Продажи по услугам" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="ServiceSalesChartContainer" Height="250"/>
                </StackPanel>
            </Border>

            <!-- График выручки по тренерам -->
            <Border Grid.Column="1" Background="White" Padding="20" Margin="5 0 0 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Выручка по тренерам" FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <ContentControl x:Name="TrainerRevenueChartContainer" Height="250"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
