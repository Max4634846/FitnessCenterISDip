<Page x:Class="FitnessCenterIS.View.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Расписание"
      Background="#fafafa">

    <Page.Resources>
        <!-- Стили для кнопок навигации -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="#090909"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стили для элементов расписания -->
        <Style x:Key="TimeSlotText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="#78909C"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,5,10,0"/>
        </Style>

        <Style x:Key="DayHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стили для карточек занятий -->
        <Style x:Key="EventContainer" TargetType="Grid">
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <Style x:Key="EventColorStrip" TargetType="Border">
            <Setter Property="Width" Value="5"/>
            <Setter Property="CornerRadius" Value="3,0,0,3"/>
        </Style>

        <Style x:Key="EventCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="0,3,3,0"/>
            <Setter Property="BorderThickness" Value="0,1,1,1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EventTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="EventInfo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления расписанием -->
        <Border Grid.Row="0" Background="White" Margin="15,10,15,0" 
                CornerRadius="10" Padding="15,12" 
                Effect="{DynamicResource MaterialDesignShadowDepth1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="PreviousButton" Style="{StaticResource NavButton}" Width="40" Click="PreviousButton_Click">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
                    </Button>
                    <Button x:Name="TodayButton" Background="#090909" BorderThickness="0" 
                            Height="40" Width="110" Click="TodayButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarToday" Width="18" Height="18" Margin="0,0,5,0"/>
                            <TextBlock Text="Сегодня" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource NavButton}" Width="40" Click="NextButton_Click">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
                    </Button>
                    <ComboBox x:Name="ViewModeComboBox" Width="120" Margin="10,0" Height="40" Padding="10,0"
                              BorderBrush="#E0E0E0" BorderThickness="1"
                              Background="White"
                              SelectionChanged="ViewModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="День"/>
                        <ComboBoxItem Content="Неделя" IsSelected="True"/>
                        <ComboBoxItem Content="Месяц"/>
                    </ComboBox>
                </StackPanel>

                <!-- Текущий диапазон дат -->
                <TextBlock x:Name="DateRangeTextBlock" Grid.Column="1" 
                           FontSize="20" FontWeight="SemiBold" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#212529"/>

                <!-- Кнопки действий -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="AddScheduleItemButton" Background="#090909" Height="40"
                            BorderThickness="0" Width="140" Click="AddScheduleItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Добавить" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PrintButton" Style="{StaticResource NavButton}" Width="40" Click="PrintButton_Click">
                        <materialDesign:PackIcon Kind="Printer" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="EmailButton" Style="{StaticResource NavButton}" Width="40" Margin="5,0" Click="EmailButton_Click">
                        <materialDesign:PackIcon Kind="Email" Width="18" Height="18" 
                                ToolTip="Отправить расписание по email"/>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Контейнер для расписания -->
        <Border Grid.Row="1" Margin="15,10,15,15" CornerRadius="10" Background="White" 
                BorderBrush="#E0E0E0" BorderThickness="1" Effect="{DynamicResource MaterialDesignShadowDepth1}">
            <ScrollViewer x:Name="ScheduleScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                          Padding="0,0,0,10">
                <Grid x:Name="ScheduleContainerGrid">
                    <!-- Календарная сетка -->
                    <Grid x:Name="ScheduleGrid" Margin="10,5">
                        <!-- Сетка будет заполнена программно -->
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>