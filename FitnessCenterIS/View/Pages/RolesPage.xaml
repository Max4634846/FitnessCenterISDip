<Page x:Class="FitnessCenterIS.View.Pages.RolesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      mc:Ignorable="d" 
      xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Роли" 
      d:DesignHeight="800" d:DesignWidth="1280">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Border CornerRadius="0 0 15 15" Margin="10 0 10 0" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#f0f0f0" Margin="10 15" 
                CornerRadius="5"  
                BorderThickness="0 3 0 3">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <WrapPanel VerticalAlignment="Center" Margin="10 0">

                    <Button Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Click="AddNewRole_Click" Margin="0 0 5 0">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AddBox" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Margin="5 0" Click="DeleteRole_Click">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Margin="5 0" Click="EditRole_Click">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Edit" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <StackPanel Margin="10">
                        <TextBox x:Name="SearchTextBox" 
                                 Width="250" materialDesign:HintAssist.Hint="Найти роль..."
                                 TextChanged="SearchTextBox_TextChanged" Padding="5" 
                                 BorderThickness="1" BorderBrush="Gray"
                                 Foreground="#090909"
                                 Style="{StaticResource MaterialDesignTextBox}"/>
                    </StackPanel>
                </WrapPanel>

                <DataGrid x:Name="BDRoles" Grid.Row="1"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True" 
                          HeadersVisibility="Column"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent" SelectionChanged="BDRoles_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                        <DataGridTextColumn Header="Количество сотрудников" Binding="{Binding StaffCount}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>