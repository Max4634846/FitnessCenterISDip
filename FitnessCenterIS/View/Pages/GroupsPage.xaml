<Page x:Class="FitnessCenterIS.View.Pages.GroupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Группы">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Border CornerRadius="0 0 15 15" Margin="10 0 10 0" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#f0f0f0" Margin="10 15" 
                CornerRadius="5" BorderThickness="0 3 0 3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <WrapPanel VerticalAlignment="Center" Margin="10 0">
                    <Button Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Click="AddGroupButton_Click" Margin="0 0 5 0">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AddBox" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Margin="5 0" Click="DeleteGroupButton_Click">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Margin="5 0" Click="EditGroupButton_Click">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Edit" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <StackPanel Margin="10">
                        <TextBox x:Name="SearchTextBox" 
                                 Width="250" materialDesign:HintAssist.Hint="Найти группу..."
                                 TextChanged="SearchTextBox_TextChanged" Padding="5" 
                                 BorderThickness="1" BorderBrush="Gray"
                                 Foreground="#090909"
                                 Style="{StaticResource MaterialDesignTextBox}"/>
                    </StackPanel>
                </WrapPanel>

                <DataGrid x:Name="GroupsDataGrid" Grid.Row="1" 
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent" SelectionChanged="GroupsDataGrid_SelectionChanged"
                          MouseDoubleClick="GroupsDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="300"/>
                        <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceName}" Width="200"/>
                        <DataGridTextColumn Header="Лимит участников" Binding="{Binding LimitCapacity}" Width="120"/>
                        <DataGridTextColumn Header="Скидка (%)" Binding="{Binding Discount}" Width="100"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusActivity}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>