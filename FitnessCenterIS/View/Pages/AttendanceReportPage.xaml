<Page x:Class="FitnessCenterIS.View.Pages.AttendanceReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View.Pages"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Отчет посещаемости">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и выбор периода -->
        <Border Grid.Row="0" Background="White" Padding="20" Margin="10" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountGroup" Width="30" Height="30" 
                                         VerticalAlignment="Center" Foreground="#090909"/>
                    <TextBlock Text="Отчет посещаемости" FontWeight="Bold" FontSize="22" 
                           VerticalAlignment="Center" Margin="10 0 0 0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Период: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <DatePicker x:Name="DateFromPicker" Width="120" Margin="5 0" 
                            SelectedDateChanged="DateRangeChanged"/>
                    <TextBlock Text=" - " VerticalAlignment="Center"/>
                    <DatePicker x:Name="DateToPicker" Width="120" Margin="5 0" 
                            SelectedDateChanged="DateRangeChanged"/>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Margin="15 0 0 0" Padding="10 5" Foreground="#090909" BorderBrush="#090909"
                        Click="ExportToExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Margin="0 0 5 0"/>
                            <TextBlock Text="Экспорт"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Margin="10 0 0 0" Padding="10 5" Foreground="#090909" BorderBrush="#090909"
                        Click="PrintReport_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Margin="0 0 5 0"/>
                            <TextBlock Text="Печать"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основные показатели -->
        <Border Grid.Row="1" Background="White" Padding="20" Margin="10 0 10 10" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Общее количество посещений -->
                <Border Grid.Column="0" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Всего посещений" FontWeight="Medium" FontSize="14"/>
                        <TextBlock x:Name="TotalVisitsTextBlock" Text="0" FontWeight="Bold" 
                               FontSize="24" Foreground="#4285F4" Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Уникальные посетители -->
                <Border Grid.Column="1" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Уникальные посетители" FontWeight="Medium" FontSize="14"/>
                        <TextBlock x:Name="UniqueVisitorsTextBlock" Text="0" FontWeight="Bold" 
                               FontSize="24" Foreground="#0F9D58" Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Посещений в день -->
                <Border Grid.Column="2" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Посещений в день (avg)" FontWeight="Medium" FontSize="14"/>
                        <TextBlock x:Name="AvgVisitsPerDayTextBlock" Text="0" FontWeight="Bold" 
                               FontSize="24" Foreground="#DB4437" Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Средняя продолжительность -->
                <Border Grid.Column="3" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Средняя продолжительность" FontWeight="Medium" FontSize="14"/>
                        <TextBlock x:Name="AvgDurationTextBlock" Text="00:00" FontWeight="Bold" 
                               FontSize="24" Foreground="#F4B400" Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Самый активный день -->
                <Border Grid.Column="4" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Самый активный день" FontWeight="Medium" FontSize="14"/>
                        <TextBlock x:Name="MostActiveWeekdayTextBlock" Text="Понедельник" FontWeight="Bold" 
                               FontSize="24" Foreground="#7B1FA2" Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Самое активное время -->
                <Border Grid.Column="5" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Самое активное время" FontWeight="Medium" FontSize="14"/>
                        <TextBlock x:Name="MostActiveTimeTextBlock" Text="18:00 - 19:00" FontWeight="Bold" 
                               FontSize="24" Foreground="#0288D1" Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Пиковая загрузка -->
                <Border Grid.Column="6" Background="#F8F9FA" Padding="15" Margin="5" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Пиковая загрузка" FontWeight="Medium" FontSize="14"/>
                        <TextBlock x:Name="PeakVisitorsTextBlock" Text="52 (01.05.2025)" FontWeight="Bold" 
                               FontSize="22" Foreground="#FF5722" Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Графики посещаемости -->
        <Grid Grid.Row="2" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- График посещаемости по часам -->
            <Border Grid.Column="0" Background="White" Padding="20" Margin="0 0 5 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Посещаемость по времени суток" 
                           FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <lvc:CartesianChart x:Name="DayTimeChart" Height="250" 
                                    DisableAnimations="True">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Время" />
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Количество" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>

            <!-- График посещаемости по дням недели -->
            <Border Grid.Column="1" Background="White" Padding="20" Margin="5 0 0 0" 
                    BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Посещаемость по дням недели" 
                           FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>
                    <lvc:CartesianChart x:Name="WeekdayChart" Height="250" 
                                    DisableAnimations="True">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="День недели" />
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Количество" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Таблица посещений -->
        <Border Grid.Row="3" Background="White" Padding="20" Margin="10 0 10 10" 
                BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Детализация посещений" 
                       FontWeight="SemiBold" FontSize="16" Margin="0 0 0 10"/>

                <DataGrid Grid.Row="1" x:Name="AttendanceDataGrid" AutoGenerateColumns="False" 
                      IsReadOnly="True" CanUserSortColumns="True"
                      BorderThickness="1" BorderBrush="#E0E0E0" 
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F5F5F5"
                      RowBackground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding AttendanceId}" Width="60"/>
                        <DataGridTextColumn Header="Дата входа" 
                                        Binding="{Binding EntryDateTime, StringFormat=dd.MM.yyyy HH:mm}" 
                                        Width="140"/>
                        <DataGridTextColumn Header="Дата выхода" 
                                        Binding="{Binding ExitDateTime, StringFormat=dd.MM.yyyy HH:mm}" 
                                        Width="140"/>
                        <DataGridTextColumn Header="Продолжительность" 
                                        Binding="{Binding Duration, StringFormat=hh\\:mm}" 
                                        Width="140"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="*"/>
                        <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceType}" Width="120"/>
                        <DataGridTextColumn Header="№ шкафчика" Binding="{Binding LockerNumber}" Width="100"/>
                        <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Итоговая строка -->
                <TextBlock Grid.Row="2" x:Name="TotalRowsTextBlock" Text="Всего записей: 0" 
                       VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 10 0 0"/>
            </Grid>
        </Border>
    </Grid>
</Page>