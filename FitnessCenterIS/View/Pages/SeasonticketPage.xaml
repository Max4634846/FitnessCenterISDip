<Page x:Class="FitnessCenterIS.View.Pages.SeasonticketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitnessCenterIS.View"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Абонементы">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Background="#f0f0f0" Margin="10 15" 
                CornerRadius="5" BorderThickness="0 3 0 3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <WrapPanel VerticalAlignment="Center" Margin="10 0">
                    <Button Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Margin="0 0 5 0" Click="AddSeasonticket_Click">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AddBox" Height="20" />
                        </WrapPanel>
                    </Button>

                    <Button Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Margin="5 0" Click="DeleteSeasonticket_Click">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <Button Width="50" Foreground="#fff" Background="#090909" 
                            BorderBrush="Transparent" Margin="5 0" Click="EditSeasonticket_Click">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Edit" Height="20"/>
                        </WrapPanel>
                    </Button>

                    <StackPanel Margin="10">
                        <TextBox x:Name="SearchTextBox" 
                                 Width="250" materialDesign:HintAssist.Hint="Найти абонемент..."
                                 TextChanged="SearchTextBox_TextChanged" Padding="5" 
                                 BorderThickness="1" BorderBrush="Gray"
                                 Foreground="#090909"
                                 Style="{StaticResource MaterialDesignTextBox}"/>
                    </StackPanel>
                </WrapPanel>

                <DataGrid x:Name="SeasonticketDataGrid" Grid.Row="1" 
                          ItemsSource="{Binding Seasontickets}"
                          SelectedItem="{Binding SelectedSeasonticket}"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent" Language="ru-RU"
                          SelectionChanged="SeasonticketDataGrid_SelectionChanged"
                          MouseDoubleClick="SeasonticketDataGrid_MouseDoubleClick">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=\{0:C\}}" Width="*"/>
                        <DataGridTextColumn Header="Срок действия (дней)" Binding="{Binding ValidityDuration}" Width="*"/>
                        <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedDateTime, StringFormat=\{0:dd.MM.yyyy\}}" Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusSeasonticket}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
